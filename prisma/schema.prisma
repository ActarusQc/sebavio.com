// Sebavio — modèles communs + Auth.js (Parties 3–4 Document 10)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Compte applicatif (Doc 4 §2). Champs Auth.js-compatibles via noms Prisma.
model User {
  id            String    @id @default(uuid(4)) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.Text
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(6)
  status        String    @db.VarChar(20)
  role          String    @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  accounts    Account[]
  sessions    Session[]
  auditLogs   AuditLog[]
  profile     UserProfile?
  preferences UserPreference?
  vehicles    UserVehicle[]
  trips       Trip[]

  @@index([status])
  @@map("users")
}

/// Constructeur (Doc 4 §4 catalogue). `source` marque la provenance (ex. seed-dev).
model Manufacturer {
  id          String   @id @default(uuid(4)) @db.Uuid
  name        String   @unique @db.VarChar(150)
  countryCode String?  @map("country_code") @db.Char(2)
  website     String?  @db.VarChar(255)
  supportUrl  String?  @map("support_url") @db.VarChar(255)
  logoUrl     String?  @map("logo_url") @db.Text
  active      Boolean  @default(true)
  /// Provenance des données : "manual" | "import" | "seed-dev" (jamais en prod).
  source      String   @default("manual") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  models VehicleModel[]

  @@index([name])
  @@index([active])
  @@index([source])
  @@map("manufacturers")
}

/// Modèle / version catalogue (année + trim = version). Specs inline (Doc 4 §4).
model VehicleModel {
  id                String   @id @default(uuid(4)) @db.Uuid
  manufacturerId    String   @map("manufacturer_id") @db.Uuid
  category          String   @db.VarChar(30)
  modelName         String   @map("model_name") @db.VarChar(150)
  trim              String   @default("") @db.VarChar(150)
  year              Int
  engine            String?  @db.VarChar(150)
  transmission      String?  @db.VarChar(100)
  driveType         String?  @map("drive_type") @db.VarChar(30)
  fuelType          String?  @map("fuel_type") @db.VarChar(30)
  fuelCapacityL     Decimal? @map("fuel_capacity_l") @db.Decimal(6, 2)
  avgConsumption    Decimal? @map("avg_consumption") @db.Decimal(6, 2)
  lengthM           Decimal? @map("length_m") @db.Decimal(6, 2)
  widthM            Decimal? @map("width_m") @db.Decimal(6, 2)
  heightM           Decimal? @map("height_m") @db.Decimal(6, 2)
  gvwrKg            Int?     @map("gvwr_kg")
  sleepingCapacity  Int?     @map("sleeping_capacity")
  freshWaterL       Int?     @map("fresh_water_l")
  greyWaterL        Int?     @map("grey_water_l")
  blackWaterL       Int?     @map("black_water_l")
  /// Provenance : "manual" | "import" | "seed-dev" (jamais en prod).
  source            String   @default("manual") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  manufacturer         Manufacturer          @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  documents            VehicleDocument[]
  knownIssues          KnownIssue[]
  userVehicles         UserVehicle[]
  maintenanceTemplates MaintenanceTemplate[]

  @@unique([manufacturerId, year, trim, modelName])
  @@index([manufacturerId, year])
  @@index([category])
  @@index([modelName])
  @@index([fuelType])
  @@index([source])
  @@map("vehicle_models")
}

/// Document catalogue (manuel, brochure…). file_url = URL saisie uniquement.
/// Pas de téléversement de fichiers à cette étape — stockage fichier = phase storage ultérieure.
model VehicleDocument {
  id           String   @id @default(uuid(4)) @db.Uuid
  modelId      String   @map("model_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  title        String   @db.VarChar(200)
  /// URL absolue saisie manuellement / import — aucun upload fichier ici.
  fileUrl      String   @map("file_url") @db.Text
  language     String   @db.Char(2)
  version      String?  @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([modelId, language])
  @@map("vehicle_documents")
}

/// Problème connu lié à un modèle catalogue (Doc 4 §4).
model KnownIssue {
  id          String   @id @default(uuid(4)) @db.Uuid
  modelId     String   @map("model_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String   @db.Text
  severity    String   @db.VarChar(20)
  source      String   @db.VarChar(200)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([modelId])
  @@map("known_issues")
}

/// Profil utilisateur 1:1 (Doc 4 §2).
model UserProfile {
  userId       String   @id @map("user_id") @db.Uuid
  firstName    String   @default("") @map("first_name") @db.VarChar(100)
  lastName     String   @default("") @map("last_name") @db.VarChar(100)
  language     String   @default("fr") @db.Char(2)
  country      String   @default("CA") @db.Char(2)
  currency     String   @default("CAD") @db.Char(3)
  timezone     String   @default("America/Toronto") @db.VarChar(100)
  travelStyle  String?  @map("travel_style") @db.VarChar(50)
  budgetLevel  String?  @map("budget_level") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([country])
  @@map("user_profiles")
}

/// Préférences utilisateur 1:1 (Doc 4 §2).
model UserPreference {
  userId                String   @id @map("user_id") @db.Uuid
  distanceUnit          String   @default("km") @map("distance_unit") @db.VarChar(10)
  temperatureUnit       String   @default("C") @map("temperature_unit") @db.VarChar(5)
  fuelUnit              String   @default("L/100") @map("fuel_unit") @db.VarChar(20)
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  aiProactive           Boolean  @default(false) @map("ai_proactive")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

/// Compte OAuth / provider (Auth.js) — Doc 4 snake_case + uuid.
model Account {
  id                String   @id @default(uuid(4)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(100)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(100)
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Session Auth.js-compatible (noms Prisma = adaptateur @auth/prisma-adapter).
model Session {
  id           String    @id @default(uuid(4)) @db.Uuid
  sessionToken String    @unique @map("session_token") @db.VarChar(255)
  userId       String    @map("user_id") @db.Uuid
  expires      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Jetons de vérification courriel / reset MDP (Auth.js + flux métier).
model VerificationToken {
  id         String   @id @default(uuid(4)) @db.Uuid
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([identifier])
  @@map("verification_tokens")
}

/// Journal d'audit immuable (Doc 4 §11) — pas de updated_at / deleted_at.
model AuditLog {
  id        String   @id @default(uuid(4)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  action    String   @db.VarChar(50)
  oldValue  Json?    @map("old_value") @db.JsonB
  newValue  Json?    @map("new_value") @db.JsonB
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Véhicule utilisateur (Doc 4 §5) — model_id nullable + saisie manuelle.
model UserVehicle {
  id                       String    @id @default(uuid(4)) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  modelId                  String?   @map("model_id") @db.Uuid
  isManualEntry            Boolean   @default(false) @map("is_manual_entry")
  manualManufacturerName   String?   @map("manual_manufacturer_name") @db.VarChar(150)
  manualModelName          String?   @map("manual_model_name") @db.VarChar(150)
  manualYear               Int?      @map("manual_year")
  manualCategory           String?   @map("manual_category") @db.VarChar(30)
  manualTrim               String?   @map("manual_trim") @db.VarChar(150)
  nickname                 String?   @db.VarChar(100)
  vin                      String?   @db.VarChar(17)
  licensePlate             String?   @map("license_plate") @db.VarChar(20)
  purchaseDate             DateTime? @map("purchase_date") @db.Date
  purchasePrice            Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  currentOdometer          Int       @map("current_odometer")
  /// Dernière mise à jour explicite de l'odomètre (création / PATCH odometer / entretien).
  odometerUpdatedAt        DateTime  @default(now()) @map("odometer_updated_at") @db.Timestamptz(6)
  realAvgConsumption       Decimal?  @map("real_avg_consumption") @db.Decimal(5, 2)
  tankCapacityOverride     Decimal?  @map("tank_capacity_override") @db.Decimal(6, 2)
  primaryVehicle           Boolean   @default(false) @map("primary_vehicle")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  model                   VehicleModel?             @relation(fields: [modelId], references: [id], onDelete: Restrict)
  documents               UserVehicleDocument[]
  photos                  VehiclePhoto[]
  settings                VehicleSettings?
  maintenanceSchedules    MaintenanceSchedule[]
  maintenanceHistories    MaintenanceHistory[]
  maintenanceNotifications MaintenanceNotification[]
  trips                   Trip[]

  @@unique([userId, vin])
  @@index([userId])
  @@index([modelId])
  @@index([vin])
  @@index([userId, primaryVehicle])
  @@index([deletedAt])
  @@index([odometerUpdatedAt])
  @@map("user_vehicles")
}

/// Gabarit d'entretien constructeur (catalogue) — Doc 4 §6.
model MaintenanceTemplate {
  id                  String   @id @default(uuid(4)) @db.Uuid
  modelId             String   @map("model_id") @db.Uuid
  title               String   @db.VarChar(150)
  category            String   @db.VarChar(50)
  intervalKm          Int?     @map("interval_km")
  intervalMonths      Int?     @map("interval_months")
  priority            String   @default("normal") @db.VarChar(20)
  description         String?  @db.Text
  manufacturerSource  String?  @map("manufacturer_source") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model     VehicleModel          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  schedules MaintenanceSchedule[]
  histories MaintenanceHistory[]

  @@index([modelId])
  @@index([category])
  @@index([priority])
  @@map("maintenance_templates")
}

/// Échéance planifiée pour un véhicule utilisateur — Doc 4 §6.
model MaintenanceSchedule {
  id               String    @id @default(uuid(4)) @db.Uuid
  vehicleId        String    @map("vehicle_id") @db.Uuid
  templateId       String?   @map("template_id") @db.Uuid
  nextDueDate      DateTime? @map("next_due_date") @db.Date
  nextDueOdometer  Int?      @map("next_due_odometer")
  status           String    @default("upcoming") @db.VarChar(20)
  lastCalculatedAt DateTime  @default(now()) @map("last_calculated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle       UserVehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  template      MaintenanceTemplate?      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  notifications MaintenanceNotification[]

  @@index([vehicleId])
  @@index([templateId])
  @@index([status])
  @@index([vehicleId, status])
  @@map("maintenance_schedule")
}

/// Entretien réalisé (historique) — Doc 4 §6. Soft delete via deleted_at.
model MaintenanceHistory {
  id                 String    @id @default(uuid(4)) @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  templateId         String?   @map("template_id") @db.Uuid
  performedDate      DateTime  @map("performed_date") @db.Date
  performedOdometer  Int       @map("performed_odometer")
  provider           String?   @db.VarChar(200)
  cost               Decimal?  @db.Decimal(10, 2)
  currency           String?   @db.Char(3)
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  vehicle   UserVehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  template  MaintenanceTemplate?   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  documents MaintenanceDocument[]

  @@index([vehicleId])
  @@index([templateId])
  @@index([vehicleId, performedDate])
  @@index([vehicleId, performedOdometer])
  @@index([deletedAt])
  @@map("maintenance_history")
}

/// Document lié à un entretien réalisé (URL saisie — pas d'upload).
model MaintenanceDocument {
  id           String   @id @default(uuid(4)) @db.Uuid
  historyId    String   @map("history_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  fileUrl      String   @map("file_url") @db.Text
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  history MaintenanceHistory @relation(fields: [historyId], references: [id], onDelete: Restrict)

  @@index([historyId])
  @@map("maintenance_documents")
}

/// Structure rappels entretien — pas d'envoi réel (module Notifications).
/// Choix Partie 10 : pas de génération en masse à chaque recalcul ;
/// lignes créées uniquement à l'approche de l'échéance (voir docs).
model MaintenanceNotification {
  id               String   @id @default(uuid(4)) @db.Uuid
  vehicleId        String   @map("vehicle_id") @db.Uuid
  scheduleId       String   @map("schedule_id") @db.Uuid
  notificationDate DateTime @map("notification_date") @db.Timestamptz(6)
  type             String   @db.VarChar(30)
  sent             Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle  UserVehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  schedule MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([scheduleId])
  @@index([sent, notificationDate])
  @@map("maintenance_notifications")
}

/// Document véhicule utilisateur (URL saisie — pas d'upload). Table distincte du catalogue.
model UserVehicleDocument {
  id         String    @id @default(uuid(4)) @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(150)
  fileUrl    String    @map("file_url") @db.Text
  expiryDate DateTime? @map("expiry_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("user_vehicle_documents")
}

/// Photo véhicule utilisateur (URL saisie).
model VehiclePhoto {
  id           String   @id @default(uuid(4)) @db.Uuid
  vehicleId    String   @map("vehicle_id") @db.Uuid
  photoUrl     String   @map("photo_url") @db.Text
  caption      String?  @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@map("vehicle_photos")
}

/// Préférences 1:1 d'un véhicule utilisateur.
model VehicleSettings {
  vehicleId           String   @id @map("vehicle_id") @db.Uuid
  preferredFuelType   String?  @map("preferred_fuel_type") @db.VarChar(30)
  winterMode          Boolean  @default(false) @map("winter_mode")
  avoidUnpavedRoads   Boolean  @default(false) @map("avoid_unpaved_roads")
  tollPreference      String?  @map("toll_preference") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@map("vehicle_settings")
}

/// Voyage utilisateur (Doc 4 §7) — travel_group_id reporté Partie 11bis.
model Trip {
  id             String    @id @default(uuid(4)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  vehicleId      String    @map("vehicle_id") @db.Uuid
  title          String    @db.VarChar(150)
  /// planned | in_progress | completed | cancelled
  status         String    @default("planned") @db.VarChar(20)
  departureDate  DateTime  @map("departure_date") @db.Timestamptz(6)
  returnDate     DateTime? @map("return_date") @db.Timestamptz(6)
  origin         String    @db.Text
  destination    String    @db.Text
  plannedBudget  Decimal?  @map("planned_budget") @db.Decimal(10, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  stops   TripStop[]
  route   TripRoute?

  @@index([userId, status])
  @@index([vehicleId])
  @@index([departureDate])
  @@index([deletedAt])
  @@map("trips")
}

/// Étape d'itinéraire — adresse texte ; lat/lng nullable (cartes = Partie 12).
model TripStop {
  id            String    @id @default(uuid(4)) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  sequence      Int
  name          String    @db.VarChar(200)
  /// Lieu / adresse en texte (pas de géocodage à cette étape).
  address       String?   @db.Text
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  arrivalTime   DateTime? @map("arrival_time") @db.Timestamptz(6)
  departureTime DateTime? @map("departure_time") @db.Timestamptz(6)
  stopType      String    @default("stop") @map("stop_type") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@unique([tripId, sequence])
  @@index([tripId, sequence])
  @@map("trip_stops")
}

/// Tracé / estimations 1:1 — champs prêts pour Google Maps / carburant (Parties 12–13).
model TripRoute {
  id                   String   @id @default(uuid(4)) @db.Uuid
  tripId               String   @unique @map("trip_id") @db.Uuid
  provider             String?  @db.VarChar(50)
  distanceKm           Decimal? @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMin Int?     @map("estimated_duration_min")
  estimatedFuelCost    Decimal? @map("estimated_fuel_cost") @db.Decimal(10, 2)
  polyline             String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@map("trip_routes")
}
