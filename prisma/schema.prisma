// Sebavio — modèles communs + Auth.js (Parties 3–4 Document 10)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Compte applicatif (Doc 4 §2). Champs Auth.js-compatibles via noms Prisma.
model User {
  id            String    @id @default(uuid(4)) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.Text
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(6)
  status        String    @db.VarChar(20)
  role          String    @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("users")
}

/// Compte OAuth / provider (Auth.js) — Doc 4 snake_case + uuid.
model Account {
  id                String   @id @default(uuid(4)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(100)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(100)
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Session Auth.js-compatible (noms Prisma = adaptateur @auth/prisma-adapter).
model Session {
  id           String    @id @default(uuid(4)) @db.Uuid
  sessionToken String    @unique @map("session_token") @db.VarChar(255)
  userId       String    @map("user_id") @db.Uuid
  expires      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Jetons de vérification courriel / reset MDP (Auth.js + flux métier).
model VerificationToken {
  id         String   @id @default(uuid(4)) @db.Uuid
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([identifier])
  @@map("verification_tokens")
}

/// Journal d'audit immuable (Doc 4 §11) — pas de updated_at / deleted_at.
model AuditLog {
  id        String   @id @default(uuid(4)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  action    String   @db.VarChar(50)
  oldValue  Json?    @map("old_value") @db.JsonB
  newValue  Json?    @map("new_value") @db.JsonB
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
