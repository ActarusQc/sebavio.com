// Sebavio — modèles communs + Auth.js (Parties 3–4 Document 10)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Compte applicatif (Doc 4 §2). Champs Auth.js-compatibles via noms Prisma.
model User {
  id            String    @id @default(uuid(4)) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.Text
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(6)
  status        String    @db.VarChar(20)
  role          String    @db.VarChar(32)
  /// Incrémente pour invalider tous les JWT existants (revoke / suspend / reset MDP).
  sessionVersion Int      @default(0) @map("session_version")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  suspendedAt   DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String? @map("suspension_reason") @db.Text
  suspendedById String?   @map("suspended_by_id") @db.Uuid
  suspensionEndsAt DateTime? @map("suspension_ends_at") @db.Timestamptz(6)
  reactivatedAt DateTime? @map("reactivated_at") @db.Timestamptz(6)
  reactivatedById String? @map("reactivated_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  accounts                Account[]
  sessions                Session[]
  auditLogs               AuditLog[]
  profile                 UserProfile?
  preferences             UserPreference?
  vehicles                UserVehicle[]
  trips                   Trip[]
  tripLocations           TripLocation[]
  travelGroups            TravelGroup[]
  campgroundFavorites     UserCampgroundFavorite[]
  activityFavorites       UserActivityFavorite[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  adminNotesAbout         AdminUserNote[] @relation("AdminNoteTarget")
  adminNotesAuthored      AdminUserNote[] @relation("AdminNoteAuthor")
  suspendedBy             User?           @relation("UserSuspensionActor", fields: [suspendedById], references: [id], onDelete: Restrict)
  suspensionsActed        User[]          @relation("UserSuspensionActor")
  reactivatedBy           User?           @relation("UserReactivationActor", fields: [reactivatedById], references: [id], onDelete: Restrict)
  reactivationsActed      User[]          @relation("UserReactivationActor")
  stripeCustomers         StripeCustomer[]
  stripeSubscriptions     StripeSubscription[]
  stripePayments          StripePayment[]
  stripeInvoices          StripeInvoice[]
  stripeRefunds           StripeRefund[]  @relation("StripeRefundUser")
  stripeRefundsCreated    StripeRefund[]  @relation("StripeRefundAdmin")
  planPurchases           PlanPurchase[]
  planAccessGrants        PlanAccessGrant[]
  planAccessGrantsRevoked PlanAccessGrant[] @relation("PlanAccessGrantRevoker")
  planAccessGrantsExtended PlanAccessGrant[] @relation("PlanAccessGrantExtender")
  aiConversations         AiConversation[]
  aiUsages                AiUsage[]
  aiVoiceSessions         AiVoiceSession[]
  aiVoiceUsages           AiVoiceUsage[]
  aiTripPlanningSessions  AiTripPlanningSession[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@map("users")
}

/// Notes administratives privées (Phase 2) — invisibles pour l'utilisateur cible.
model AdminUserNote {
  id         String    @id @default(uuid(4)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  category   String    @db.VarChar(30)
  importance String    @default("normal") @db.VarChar(20)
  content    String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user   User @relation("AdminNoteTarget", fields: [userId], references: [id], onDelete: Restrict)
  author User @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([authorId])
  @@index([category])
  @@map("admin_user_notes")
}

/// Constructeur (Doc 4 §4 catalogue). `source` marque la provenance (ex. seed-dev).
model Manufacturer {
  id          String   @id @default(uuid(4)) @db.Uuid
  name        String   @unique @db.VarChar(150)
  countryCode String?  @map("country_code") @db.Char(2)
  website     String?  @db.VarChar(255)
  supportUrl  String?  @map("support_url") @db.VarChar(255)
  logoUrl     String?  @map("logo_url") @db.Text
  active      Boolean  @default(true)
  /// Provenance des données : "manual" | "import" | "seed-dev" (jamais en prod).
  source      String   @default("manual") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  models VehicleModel[]

  @@index([name])
  @@index([active])
  @@index([source])
  @@map("manufacturers")
}

/// Modèle / version catalogue (année + trim = version). Specs inline (Doc 4 §4).
model VehicleModel {
  id                String   @id @default(uuid(4)) @db.Uuid
  manufacturerId    String   @map("manufacturer_id") @db.Uuid
  category          String   @db.VarChar(30)
  modelName         String   @map("model_name") @db.VarChar(150)
  trim              String   @default("") @db.VarChar(150)
  year              Int
  engine            String?  @db.VarChar(150)
  transmission      String?  @db.VarChar(100)
  driveType         String?  @map("drive_type") @db.VarChar(30)
  fuelType          String?  @map("fuel_type") @db.VarChar(30)
  fuelCapacityL     Decimal? @map("fuel_capacity_l") @db.Decimal(6, 2)
  avgConsumption    Decimal? @map("avg_consumption") @db.Decimal(6, 2)
  lengthM           Decimal? @map("length_m") @db.Decimal(6, 2)
  widthM            Decimal? @map("width_m") @db.Decimal(6, 2)
  heightM           Decimal? @map("height_m") @db.Decimal(6, 2)
  gvwrKg            Int?     @map("gvwr_kg")
  sleepingCapacity  Int?     @map("sleeping_capacity")
  freshWaterL       Int?     @map("fresh_water_l")
  greyWaterL        Int?     @map("grey_water_l")
  blackWaterL       Int?     @map("black_water_l")
  /// Provenance : "manual" | "import" | "seed-dev" (jamais en prod).
  source            String   @default("manual") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  manufacturer         Manufacturer          @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  documents            VehicleDocument[]
  knownIssues          KnownIssue[]
  userVehicles         UserVehicle[]
  maintenanceTemplates MaintenanceTemplate[]

  @@unique([manufacturerId, year, trim, modelName])
  @@index([manufacturerId, year])
  @@index([category])
  @@index([modelName])
  @@index([fuelType])
  @@index([source])
  @@map("vehicle_models")
}

/// Document catalogue (manuel, brochure…). file_url = URL saisie uniquement.
/// Pas de téléversement de fichiers à cette étape — stockage fichier = phase storage ultérieure.
model VehicleDocument {
  id           String   @id @default(uuid(4)) @db.Uuid
  modelId      String   @map("model_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  title        String   @db.VarChar(200)
  /// URL absolue saisie manuellement / import — aucun upload fichier ici.
  fileUrl      String   @map("file_url") @db.Text
  language     String   @db.Char(2)
  version      String?  @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([modelId, language])
  @@map("vehicle_documents")
}

/// Problème connu lié à un modèle catalogue (Doc 4 §4).
model KnownIssue {
  id          String   @id @default(uuid(4)) @db.Uuid
  modelId     String   @map("model_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String   @db.Text
  severity    String   @db.VarChar(20)
  source      String   @db.VarChar(200)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([modelId])
  @@map("known_issues")
}

/// Profil utilisateur 1:1 (Doc 4 §2).
model UserProfile {
  userId       String   @id @map("user_id") @db.Uuid
  firstName    String   @default("") @map("first_name") @db.VarChar(100)
  lastName     String   @default("") @map("last_name") @db.VarChar(100)
  language     String   @default("fr") @db.Char(2)
  country      String   @default("CA") @db.Char(2)
  currency     String   @default("CAD") @db.Char(3)
  timezone     String   @default("America/Toronto") @db.VarChar(100)
  travelStyle  String?  @map("travel_style") @db.VarChar(50)
  budgetLevel  String?  @map("budget_level") @db.VarChar(30)
  /// Adresse de domicile (départ proposé — planification IA).
  homeAddressLabel      String?  @map("home_address_label") @db.Text
  homeAddressPlaceId    String?  @map("home_address_place_id") @db.VarChar(255)
  homeAddressLatitude   Decimal? @map("home_address_latitude") @db.Decimal(10, 7)
  homeAddressLongitude  Decimal? @map("home_address_longitude") @db.Decimal(10, 7)
  homeAddressCity       String?  @map("home_address_city") @db.VarChar(120)
  homeAddressProvince   String?  @map("home_address_province") @db.VarChar(120)
  homeAddressPostalCode String?  @map("home_address_postal_code") @db.VarChar(20)
  homeAddressCountry    String?  @map("home_address_country") @db.VarChar(2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([country])
  @@map("user_profiles")
}

/// Préférences utilisateur 1:1 (Doc 4 §2).
model UserPreference {
  userId                String   @id @map("user_id") @db.Uuid
  distanceUnit          String   @default("km") @map("distance_unit") @db.VarChar(10)
  temperatureUnit       String   @default("C") @map("temperature_unit") @db.VarChar(5)
  fuelUnit              String   @default("L/100") @map("fuel_unit") @db.VarChar(20)
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  aiProactive           Boolean  @default(false) @map("ai_proactive")
  /// Si false, les stations Costco sont exclues du plan de ravitaillement.
  costcoMember          Boolean  @default(false) @map("costco_member")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

/// Compte OAuth / provider (Auth.js) — Doc 4 snake_case + uuid.
model Account {
  id                String   @id @default(uuid(4)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(100)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(100)
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Session Auth.js-compatible (noms Prisma = adaptateur @auth/prisma-adapter).
model Session {
  id           String    @id @default(uuid(4)) @db.Uuid
  sessionToken String    @unique @map("session_token") @db.VarChar(255)
  userId       String    @map("user_id") @db.Uuid
  expires      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Jetons de vérification courriel / reset MDP (Auth.js + flux métier).
model VerificationToken {
  id         String   @id @default(uuid(4)) @db.Uuid
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([identifier])
  @@map("verification_tokens")
}

/// Journal d'audit immuable (Doc 4 §11) — pas de updated_at / deleted_at.
/// Champs admin optionnels (Phase 1) : actorRole, reason, userAgent, requestId.
model AuditLog {
  id         String   @id @default(uuid(4)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// Rôle de l'acteur au moment de l'action (`system` pour scripts CLI).
  actorRole  String?  @map("actor_role") @db.VarChar(32)
  entity     String   @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  action     String   @db.VarChar(80)
  reason     String?  @db.Text
  oldValue   Json?    @map("old_value") @db.JsonB
  newValue   Json?    @map("new_value") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([actorRole])
  @@map("audit_logs")
}

/// Véhicule utilisateur (Doc 4 §5) — model_id nullable + saisie manuelle + catalogue NRCan.
model UserVehicle {
  id                       String    @id @default(uuid(4)) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  modelId                  String?   @map("model_id") @db.Uuid
  /// Entrée cotes NRCan (consommation officielle canadienne).
  catalogEntryId           String?   @map("catalog_entry_id") @db.Uuid
  isManualEntry            Boolean   @default(false) @map("is_manual_entry")
  manualManufacturerName   String?   @map("manual_manufacturer_name") @db.VarChar(150)
  manualModelName          String?   @map("manual_model_name") @db.VarChar(150)
  manualYear               Int?      @map("manual_year")
  manualCategory           String?   @map("manual_category") @db.VarChar(30)
  manualTrim               String?   @map("manual_trim") @db.VarChar(150)
  nickname                 String?   @db.VarChar(100)
  vin                      String?   @db.VarChar(17)
  licensePlate             String?   @map("license_plate") @db.VarChar(20)
  purchaseDate             DateTime? @map("purchase_date") @db.Date
  purchasePrice            Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  currentOdometer          Int       @map("current_odometer")
  /// Dernière mise à jour explicite de l'odomètre (création / PATCH odometer / entretien).
  odometerUpdatedAt        DateTime  @default(now()) @map("odometer_updated_at") @db.Timestamptz(6)
  realAvgConsumption       Decimal?  @map("real_avg_consumption") @db.Decimal(5, 2)
  /// Override utilisateur explicite (L/100 km) — prioritaire sur constructeur / moyenne pleins.
  customConsumptionL100    Decimal?  @map("custom_consumption_l100") @db.Decimal(5, 2)
  /// Type carburant normalisé (regular, premium, diesel, electric, …) — valeur courante / legacy.
  fuelType                 String?   @map("fuel_type") @db.VarChar(40)
  /// Type carburant constructeur / catalogue (jamais écrasé par une personnalisation).
  manufacturerFuelType     String?   @map("manufacturer_fuel_type") @db.VarChar(40)
  /// Override utilisateur du type de carburant.
  customFuelType           String?   @map("custom_fuel_type") @db.VarChar(40)
  /// Consommations officielles (catalogue NRCan ou saisie manuelle déclarée).
  officialCityConsumptionL100     Decimal? @map("official_city_consumption_l100") @db.Decimal(6, 2)
  officialHighwayConsumptionL100  Decimal? @map("official_highway_consumption_l100") @db.Decimal(6, 2)
  officialCombinedConsumptionL100 Decimal? @map("official_combined_consumption_l100") @db.Decimal(6, 2)
  /// nrcan_catalog | user_manual | legacy_model | null
  consumptionDataSource    String?   @map("consumption_data_source") @db.VarChar(40)
  tankCapacityOverride     Decimal?  @map("tank_capacity_override") @db.Decimal(6, 2)
  /// Capacité réservoir constructeur / catalogue (valeur suggérée, non écrasée).
  manufacturerTankCapacityL Decimal? @map("manufacturer_tank_capacity_l") @db.Decimal(6, 2)
  /// user_manual | catalog | legacy_model | null
  tankCapacitySource       String?   @map("tank_capacity_source") @db.VarChar(40)
  tankCapacityUpdatedAt    DateTime? @map("tank_capacity_updated_at") @db.Timestamptz(6)
  /// Overrides optionnels (dimensions, poids, autonomie électrique, batterie).
  specOverrides            Json?     @map("spec_overrides") @db.JsonB
  /// Horodatage dernière modif des specs influençant le calcul carburant.
  specsUpdatedAt           DateTime? @map("specs_updated_at") @db.Timestamptz(6)
  primaryVehicle           Boolean   @default(false) @map("primary_vehicle")
  /// Motorisation / transmission (décodage VIN ou saisie manuelle).
  engine                   String?   @db.VarChar(150)
  transmission             String?   @db.VarChar(80)
  drivetrain               String?   @db.VarChar(80)
  vehicleType              String?   @map("vehicle_type") @db.VarChar(80)
  bodyClass                String?   @map("body_class") @db.VarChar(80)
  cylinders                Int?
  displacementL            Decimal?  @map("displacement_l") @db.Decimal(4, 1)
  plantCountry             String?   @map("plant_country") @db.VarChar(80)
  manufacturerName         String?   @map("manufacturer_name") @db.VarChar(150)
  /// Kilométrage annuel estimé (profil d’usage / calcul échéances).
  annualEstimatedKm        Int?      @map("annual_estimated_km")
  /// Date de mise en service (sinon purchase_date).
  inServiceDate            DateTime? @map("in_service_date") @db.Date
  /// vin | manual | nrcan | mixed
  identificationSource     String?   @map("identification_source") @db.VarChar(30)
  /// high | medium | low | ambiguous
  identificationConfidence String?   @map("identification_confidence") @db.VarChar(20)
  /// normal | severe | automatic
  usageProfile             String    @default("automatic") @map("usage_profile") @db.VarChar(20)
  /// Facteurs d’usage sévère (JSON) — courts trajets, remorquage, etc.
  usageFactors             Json?     @map("usage_factors") @db.JsonB
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  model                   VehicleModel?             @relation(fields: [modelId], references: [id], onDelete: Restrict)
  catalogEntry            VehicleCatalogEntry?      @relation(fields: [catalogEntryId], references: [id], onDelete: Restrict)
  documents               UserVehicleDocument[]
  photos                  VehiclePhoto[]
  settings                VehicleSettings?
  maintenanceSchedules    MaintenanceSchedule[]
  maintenanceHistories    MaintenanceHistory[]
  maintenanceNotifications MaintenanceNotification[]
  providerMaintenanceSchedules ProviderMaintenanceSchedule[]
  maintenanceReminders    VehicleMaintenanceReminder[]
  safetyRecalls           VehicleSafetyRecall[]
  fuelLogs                FuelLog[]
  trips                   Trip[]

  @@unique([userId, vin])
  @@index([userId])
  @@index([modelId])
  @@index([catalogEntryId])
  @@index([vin])
  @@index([userId, primaryVehicle])
  @@index([deletedAt])
  @@index([odometerUpdatedAt])
  @@map("user_vehicles")
}

/// Cote de consommation officielle (Ressources naturelles Canada).
model VehicleCatalogEntry {
  id                          String    @id @default(uuid(4)) @db.Uuid
  sourceKey                   String    @unique @map("source_key") @db.VarChar(64)
  modelYear                   Int       @map("model_year")
  make                        String    @db.VarChar(150)
  makeNormalized              String    @map("make_normalized") @db.VarChar(150)
  model                       String    @db.VarChar(200)
  modelNormalized             String    @map("model_normalized") @db.VarChar(200)
  configuration               String?   @db.VarChar(300)
  vehicleClass                String?   @map("vehicle_class") @db.VarChar(120)
  engineSizeLitres            Decimal?  @map("engine_size_litres") @db.Decimal(4, 1)
  cylinders                   Int?
  transmission                String?   @db.VarChar(40)
  transmissionCode            String?   @map("transmission_code") @db.VarChar(40)
  fuelType                    String?   @map("fuel_type") @db.VarChar(80)
  normalizedFuelType          String?   @map("normalized_fuel_type") @db.VarChar(40)
  cityConsumptionL100Km       Decimal?  @map("city_consumption_l100_km") @db.Decimal(6, 2)
  highwayConsumptionL100Km    Decimal?  @map("highway_consumption_l100_km") @db.Decimal(6, 2)
  combinedConsumptionL100Km   Decimal?  @map("combined_consumption_l100_km") @db.Decimal(6, 2)
  combinedMpg                 Decimal?  @map("combined_mpg") @db.Decimal(6, 1)
  co2EmissionsGKm             Int?      @map("co2_emissions_g_km")
  co2Rating                   Int?      @map("co2_rating")
  smogRating                  Int?      @map("smog_rating")
  electricConsumptionKwh100Km Decimal?  @map("electric_consumption_kwh_100_km") @db.Decimal(6, 2)
  electricRangeKm             Int?      @map("electric_range_km")
  /// Capacité réservoir (L) si connue — NRCan ne fournit pas ce champ.
  fuelTankCapacityL           Decimal?  @map("fuel_tank_capacity_l") @db.Decimal(6, 2)
  sourceName                  String    @map("source_name") @db.VarChar(120)
  sourceDataset               String?   @map("source_dataset") @db.VarChar(200)
  sourceResourceUrl           String?   @map("source_resource_url") @db.Text
  sourceYear                  Int?      @map("source_year")
  importedAt                  DateTime  @map("imported_at") @db.Timestamptz(6)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  isActive                    Boolean   @default(true) @map("is_active")
  rawData                     Json?     @map("raw_data") @db.JsonB

  userVehicles UserVehicle[]

  @@index([modelYear])
  @@index([modelYear, makeNormalized])
  @@index([modelYear, makeNormalized, modelNormalized])
  @@index([normalizedFuelType])
  @@index([isActive])
  @@map("vehicle_catalog_entries")
}

/// Journal de synchronisation du catalogue NRCan.
model VehicleCatalogSync {
  id                String    @id @default(uuid(4)) @db.Uuid
  status            String    @db.VarChar(30)
  startedAt         DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  sourceDataset     String?   @map("source_dataset") @db.VarChar(200)
  sourceResourceUrl String?   @map("source_resource_url") @db.Text
  sourceChecksum    String?   @map("source_checksum") @db.VarChar(128)
  sourceModifiedAt  DateTime? @map("source_modified_at") @db.Timestamptz(6)
  recordsRead       Int       @default(0) @map("records_read")
  recordsCreated    Int       @default(0) @map("records_created")
  recordsUpdated    Int       @default(0) @map("records_updated")
  recordsUnchanged  Int       @default(0) @map("records_unchanged")
  recordsRejected   Int       @default(0) @map("records_rejected")
  errorMessage      String?   @map("error_message") @db.Text
  metadata          Json?     @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("vehicle_catalog_syncs")
}

/// Plein carburant (suivi conso réelle) — Partie 13 / Doc 4 §5 (dérivé).
model FuelLog {
  id            String    @id @default(uuid(4)) @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  filledAt      DateTime  @map("filled_at") @db.Date
  odometerKm    Int       @map("odometer_km")
  liters        Decimal   @db.Decimal(8, 3)
  pricePerLiter Decimal   @map("price_per_liter") @db.Decimal(8, 3)
  /// Montant réellement payé (facture) — peut différer de liters×prix de quelques cents.
  totalCost     Decimal   @map("total_cost") @db.Decimal(10, 2)
  isFull        Boolean   @default(true) @map("is_full")
  fuelType      String?   @map("fuel_type") @db.VarChar(30)
  stationName   String?   @map("station_name") @db.VarChar(200)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// Dépense voyage créée via « Ajouter aux dépenses » (anti-double-import).
  expense Expense?

  @@index([vehicleId])
  @@index([vehicleId, filledAt])
  @@index([vehicleId, odometerKm])
  @@index([deletedAt])
  @@map("fuel_logs")
}

/// Station-service (Régie Essence Québec) — Partie 13bis.
model FuelStation {
  id            String    @id @default(uuid(4)) @db.Uuid
  /// Clé naturelle stable (hash nom+adresse, sinon lat/lng).
  externalKey   String    @unique @map("external_key") @db.VarChar(64)
  name          String    @db.VarChar(200)
  banner        String?   @db.VarChar(120)
  address       String    @db.VarChar(300)
  region        String?   @db.VarChar(120)
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  countryCode   String    @default("CA") @map("country_code") @db.Char(2)
  /// Ingestions consécutives sans apparition (soft-delete à ≥ 3).
  missingStreak Int       @default(0) @map("missing_streak")
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  prices FuelPrice[]

  @@index([region])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([lastSeenAt])
  @@map("fuel_stations")
}

/// Historique des prix carburant par station (jamais écrasé) — Partie 13bis / Doc 4.
model FuelPrice {
  id          String   @id @default(uuid(4)) @db.Uuid
  stationId   String   @map("station_id") @db.Uuid
  /// regular | premium | diesel
  fuelType    String   @map("fuel_type") @db.VarChar(30)
  /// Prix en dollars canadiens par litre.
  price       Decimal  @db.Decimal(8, 3)
  capturedAt  DateTime @map("captured_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  station FuelStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([stationId, fuelType, capturedAt(sort: Desc)])
  @@index([fuelType, capturedAt])
  @@index([capturedAt])
  @@map("fuel_prices")
}

/// Journal des ingestions Régie (rate-limit + rapport).
model FuelIngestion {
  id         String    @id @default(uuid(4)) @db.Uuid
  /// success | refused | failed
  status     String    @db.VarChar(20)
  sourceUrl  String?   @map("source_url") @db.Text
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  report     Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("fuel_ingestions")
}

/// Gabarit d'entretien constructeur (catalogue) — Doc 4 §6.
model MaintenanceTemplate {
  id                  String   @id @default(uuid(4)) @db.Uuid
  modelId             String   @map("model_id") @db.Uuid
  title               String   @db.VarChar(150)
  category            String   @db.VarChar(50)
  intervalKm          Int?     @map("interval_km")
  intervalMonths      Int?     @map("interval_months")
  priority            String   @default("normal") @db.VarChar(20)
  description         String?  @db.Text
  manufacturerSource  String?  @map("manufacturer_source") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model     VehicleModel          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  schedules MaintenanceSchedule[]
  histories MaintenanceHistory[]

  @@index([modelId])
  @@index([category])
  @@index([priority])
  @@map("maintenance_templates")
}

/// Échéance planifiée pour un véhicule utilisateur — Doc 4 §6.
model MaintenanceSchedule {
  id               String    @id @default(uuid(4)) @db.Uuid
  vehicleId        String    @map("vehicle_id") @db.Uuid
  templateId       String?   @map("template_id") @db.Uuid
  nextDueDate      DateTime? @map("next_due_date") @db.Date
  nextDueOdometer  Int?      @map("next_due_odometer")
  status           String    @default("upcoming") @db.VarChar(20)
  lastCalculatedAt DateTime  @default(now()) @map("last_calculated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle       UserVehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  template      MaintenanceTemplate?      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  notifications MaintenanceNotification[]

  @@index([vehicleId])
  @@index([templateId])
  @@index([status])
  @@index([vehicleId, status])
  @@map("maintenance_schedule")
}

/// Entretien réalisé (historique) — Doc 4 §6. Soft delete via deleted_at.
model MaintenanceHistory {
  id                 String    @id @default(uuid(4)) @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  templateId         String?   @map("template_id") @db.Uuid
  /// Tâche synchronisée depuis un fournisseur d’entretien.
  taskDefinitionId   String?   @map("task_definition_id") @db.Uuid
  performedDate      DateTime  @map("performed_date") @db.Date
  performedOdometer  Int       @map("performed_odometer")
  /// completed | partial | cancelled
  status             String    @default("completed") @db.VarChar(20)
  provider           String?   @db.VarChar(200)
  invoiceNumber      String?   @map("invoice_number") @db.VarChar(100)
  cost               Decimal?  @db.Decimal(10, 2)
  currency           String?   @db.Char(3)
  notes              String?   @db.Text
  attachmentUrl      String?   @map("attachment_url") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  vehicle        UserVehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  template       MaintenanceTemplate?     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  taskDefinition MaintenanceTaskDefinition? @relation(fields: [taskDefinitionId], references: [id], onDelete: Restrict)
  documents      MaintenanceDocument[]
  completedReminders VehicleMaintenanceReminder[]

  @@index([vehicleId])
  @@index([templateId])
  @@index([taskDefinitionId])
  @@index([vehicleId, performedDate])
  @@index([vehicleId, performedOdometer])
  @@index([deletedAt])
  @@map("maintenance_history")
}

/// Document lié à un entretien réalisé (URL saisie — pas d'upload).
model MaintenanceDocument {
  id           String   @id @default(uuid(4)) @db.Uuid
  historyId    String   @map("history_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  fileUrl      String   @map("file_url") @db.Text
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  history MaintenanceHistory @relation(fields: [historyId], references: [id], onDelete: Restrict)

  @@index([historyId])
  @@map("maintenance_documents")
}

/// Structure rappels entretien — pas d'envoi réel (module Notifications).
/// Choix Partie 10 : pas de génération en masse à chaque recalcul ;
/// lignes créées uniquement à l'approche de l'échéance (voir docs).
model MaintenanceNotification {
  id               String   @id @default(uuid(4)) @db.Uuid
  vehicleId        String   @map("vehicle_id") @db.Uuid
  scheduleId       String   @map("schedule_id") @db.Uuid
  notificationDate DateTime @map("notification_date") @db.Timestamptz(6)
  type             String   @db.VarChar(30)
  sent             Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle  UserVehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  schedule MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([scheduleId])
  @@index([sent, notificationDate])
  @@map("maintenance_notifications")
}

/// Calendrier d’entretien importé d’un fournisseur (MOTOR, DataOne, mock, manuel…).
model ProviderMaintenanceSchedule {
  id                 String   @id @default(uuid(4)) @db.Uuid
  vehicleId          String   @map("vehicle_id") @db.Uuid
  /// Identifiant logique du fournisseur (mock | commercial | manual | …).
  provider           String   @db.VarChar(50)
  providerVehicleId  String?  @map("provider_vehicle_id") @db.VarChar(120)
  /// commercial | mock | manual | cached
  sourceType         String   @map("source_type") @db.VarChar(30)
  sourceReference    String?  @map("source_reference") @db.VarChar(255)
  sourceRetrievedAt  DateTime @map("source_retrieved_at") @db.Timestamptz(6)
  sourceVersion      String?  @map("source_version") @db.VarChar(80)
  normalConditions   Boolean  @default(true) @map("normal_conditions")
  severeConditions   Boolean  @default(false) @map("severe_conditions")
  rawDataHash        String?  @map("raw_data_hash") @db.VarChar(64)
  /// true si la dernière sync a échoué et que l’on sert le cache local.
  isStale            Boolean  @default(false) @map("is_stale")
  lastSyncError      String?  @map("last_sync_error") @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  tasks   MaintenanceTaskDefinition[]

  @@unique([vehicleId, provider])
  @@index([vehicleId])
  @@index([provider])
  @@index([sourceRetrievedAt])
  @@map("provider_maintenance_schedules")
}

/// Recommandation d’entretien normalisée (issue d’un calendrier fournisseur).
model MaintenanceTaskDefinition {
  id                                 String   @id @default(uuid(4)) @db.Uuid
  scheduleId                         String   @map("schedule_id") @db.Uuid
  externalId                         String?  @map("external_id") @db.VarChar(120)
  category                           String   @db.VarChar(50)
  title                              String   @db.VarChar(200)
  description                        String?  @db.Text
  actionType                         String   @map("action_type") @db.VarChar(30)
  intervalKm                         Int?     @map("interval_km")
  intervalMonths                     Int?     @map("interval_months")
  firstDueKm                         Int?     @map("first_due_km")
  firstDueMonths                     Int?     @map("first_due_months")
  /// normal | severe | both
  conditionType                      String   @default("both") @map("condition_type") @db.VarChar(20)
  /// low | medium | high | critical
  priority                           String   @default("medium") @db.VarChar(20)
  officialManufacturerRecommendation Boolean  @default(false) @map("official_manufacturer_recommendation")
  inspectionOnly                     Boolean  @default(false) @map("inspection_only")
  estimatedDurationMinutes           Int?     @map("estimated_duration_minutes")
  notes                              String?  @db.Text
  createdAt                          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule  ProviderMaintenanceSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  histories MaintenanceHistory[]
  reminders VehicleMaintenanceReminder[]

  @@unique([scheduleId, externalId])
  @@index([scheduleId])
  @@index([category])
  @@index([priority])
  @@map("maintenance_task_definitions")
}

/// Rappel d’entretien généré automatiquement à partir d’une tâche normalisée.
model VehicleMaintenanceReminder {
  id                 String    @id @default(uuid(4)) @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  taskDefinitionId   String    @map("task_definition_id") @db.Uuid
  dueDate            DateTime? @map("due_date") @db.Date
  dueOdometerKm      Int?      @map("due_odometer_km")
  /// overdue | due_now | due_soon | upcoming | completed | dismissed | unknown
  status             String    @default("upcoming") @db.VarChar(20)
  /// low | medium | high | critical
  priority           String    @default("medium") @db.VarChar(20)
  /// provider | calculated | manual
  calculationSource  String    @default("calculated") @map("calculation_source") @db.VarChar(30)
  dismissedUntil     DateTime? @map("dismissed_until") @db.Timestamptz(6)
  completedEventId   String?   @map("completed_event_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle        UserVehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  taskDefinition MaintenanceTaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  completedEvent MaintenanceHistory?       @relation(fields: [completedEventId], references: [id], onDelete: SetNull)

  @@unique([vehicleId, taskDefinitionId])
  @@index([vehicleId, status])
  @@index([dueDate])
  @@index([dueOdometerKm])
  @@index([dismissedUntil])
  @@map("vehicle_maintenance_reminders")
}

/// Rappel de sécurité officiel (Transport Canada / sources publiques).
model VehicleSafetyRecall {
  id                String    @id @default(uuid(4)) @db.Uuid
  vehicleId         String    @map("vehicle_id") @db.Uuid
  externalRecallId  String    @map("external_recall_id") @db.VarChar(120)
  /// transport_canada | nhtsa | other
  source            String    @db.VarChar(40)
  manufacturer      String?   @db.VarChar(150)
  model             String?   @db.VarChar(150)
  year              Int?
  title             String    @db.VarChar(300)
  summary           String?   @db.Text
  riskDescription   String?   @map("risk_description") @db.Text
  correctiveAction  String?   @map("corrective_action") @db.Text
  recallDate        DateTime? @map("recall_date") @db.Date
  officialUrl       String?   @map("official_url") @db.Text
  /// open | possibly_applicable | repaired | not_applicable | dismissed
  status            String    @default("possibly_applicable") @db.VarChar(30)
  /// true si le VIN n’a pas pu confirmer l’applicabilité exacte.
  vinMatchUncertain Boolean   @default(true) @map("vin_match_uncertain")
  lastCheckedAt     DateTime  @map("last_checked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, source, externalRecallId])
  @@index([vehicleId, status])
  @@index([lastCheckedAt])
  @@map("vehicle_safety_recalls")
}

/// Cache persistant des réponses fournisseurs d’entretien.
model MaintenanceProviderCache {
  id             String   @id @default(uuid(4)) @db.Uuid
  cacheKey       String   @unique @map("cache_key") @db.VarChar(128)
  provider       String   @db.VarChar(50)
  vinNormalized  String?  @map("vin_normalized") @db.VarChar(17)
  year           Int?
  make           String?  @db.VarChar(150)
  model          String?  @db.VarChar(150)
  trim           String?  @db.VarChar(150)
  engine         String?  @db.VarChar(150)
  payload        Json     @db.JsonB
  sourceVersion  String?  @map("source_version") @db.VarChar(80)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([provider])
  @@index([expiresAt])
  @@index([vinNormalized])
  @@map("maintenance_provider_cache")
}

/// Document véhicule utilisateur (URL saisie — pas d'upload). Table distincte du catalogue.
model UserVehicleDocument {
  id         String    @id @default(uuid(4)) @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(150)
  fileUrl    String    @map("file_url") @db.Text
  expiryDate DateTime? @map("expiry_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("user_vehicle_documents")
}

/// Photo véhicule utilisateur (URL saisie).
model VehiclePhoto {
  id           String   @id @default(uuid(4)) @db.Uuid
  vehicleId    String   @map("vehicle_id") @db.Uuid
  photoUrl     String   @map("photo_url") @db.Text
  caption      String?  @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@map("vehicle_photos")
}

/// Préférences 1:1 d'un véhicule utilisateur.
model VehicleSettings {
  vehicleId           String   @id @map("vehicle_id") @db.Uuid
  preferredFuelType   String?  @map("preferred_fuel_type") @db.VarChar(30)
  winterMode          Boolean  @default(false) @map("winter_mode")
  avoidUnpavedRoads   Boolean  @default(false) @map("avoid_unpaved_roads")
  tollPreference      String?  @map("toll_preference") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle UserVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@map("vehicle_settings")
}

/// Groupe de voyageurs (Doc 4 §3) — fiches descriptives, pas de comptes invités.
model TravelGroup {
  id           String    @id @default(uuid(4)) @db.Uuid
  ownerUserId  String    @map("owner_user_id") @db.Uuid
  name         String    @db.VarChar(150)
  defaultGroup Boolean   @default(false) @map("default_group")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner       User                @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  members     TravelMember[]
  pets        Pet[]
  preferences TravelPreferences?
  trips       Trip[]

  @@index([ownerUserId])
  @@index([ownerUserId, defaultGroup])
  @@index([deletedAt])
  @@map("travel_groups")
}

/// Membre du groupe — fiche descriptive du propriétaire (pas un User).
/// Hard-delete OK tant qu'aucune autre table ne référence ce membre.
/// Si une future table (ex. réservations par membre) les référence → migrer vers soft-delete.
model TravelMember {
  id            String    @id @default(uuid(4)) @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  firstName     String    @map("first_name") @db.VarChar(100)
  birthDate     DateTime? @map("birth_date") @db.Date
  relationship  String?   @db.VarChar(30)
  mobilityLevel String?   @map("mobility_level") @db.VarChar(30)
  specialNeeds  String?   @map("special_needs") @db.Text
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  group TravelGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@map("travel_members")
}

/// Animal du groupe.
/// Hard-delete OK tant qu'aucune autre table ne référence cet animal.
/// Si une future table les référence → migrer vers soft-delete.
model Pet {
  id        String   @id @default(uuid(4)) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String   @db.VarChar(100)
  species   String?  @db.VarChar(50)
  breed     String?  @db.VarChar(100)
  weightKg  Decimal? @map("weight_kg") @db.Decimal(5, 2)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group TravelGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@map("pets")
}

/// Préférences 1:1 d'un groupe de voyage (Doc 4 §3).
model TravelPreferences {
  groupId                 String   @id @map("group_id") @db.Uuid
  maxDriveHours           Decimal? @map("max_drive_hours") @db.Decimal(4, 1)
  dailyBudget             Decimal? @map("daily_budget") @db.Decimal(10, 2)
  preferredCampgroundType String?  @map("preferred_campground_type") @db.VarChar(50)
  avoidTolls              Boolean  @default(false) @map("avoid_tolls")
  avoidFerries            Boolean  @default(false) @map("avoid_ferries")
  preferredActivityTypes  Json?    @map("preferred_activity_types")
  foodPreferences         Json?    @map("food_preferences")
  accessibilityRequired   Boolean  @default(false) @map("accessibility_required")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group TravelGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@map("travel_preferences")
}

/// Voyage utilisateur (Doc 4 §7) — travel_group_id optionnel (Partie 11bis).
model Trip {
  id             String    @id @default(uuid(4)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  vehicleId      String    @map("vehicle_id") @db.Uuid
  travelGroupId  String?   @map("travel_group_id") @db.Uuid
  title          String    @db.VarChar(150)
  /// planned | in_progress | completed | cancelled
  status         String    @default("planned") @db.VarChar(20)
  departureDate  DateTime  @map("departure_date") @db.Timestamptz(6)
  returnDate     DateTime? @map("return_date") @db.Timestamptz(6)
  /// Adresse affichée départ (saisie manuelle ou Google Places).
  origin         String    @db.Text
  originPlaceId  String?   @map("origin_place_id") @db.VarChar(255)
  originLatitude Decimal?  @map("origin_latitude") @db.Decimal(10, 7)
  originLongitude Decimal? @map("origin_longitude") @db.Decimal(10, 7)
  originCity     String?   @map("origin_city") @db.VarChar(120)
  originProvince String?   @map("origin_province") @db.VarChar(120)
  originPostalCode String? @map("origin_postal_code") @db.VarChar(20)
  originCountry  String?   @map("origin_country") @db.VarChar(2)
  /// Adresse affichée destination (saisie manuelle ou Google Places).
  destination         String    @db.Text
  destinationPlaceId  String?   @map("destination_place_id") @db.VarChar(255)
  destinationLatitude Decimal?  @map("destination_latitude") @db.Decimal(10, 7)
  destinationLongitude Decimal? @map("destination_longitude") @db.Decimal(10, 7)
  destinationCity     String?   @map("destination_city") @db.VarChar(120)
  destinationProvince String?   @map("destination_province") @db.VarChar(120)
  destinationPostalCode String? @map("destination_postal_code") @db.VarChar(20)
  destinationCountry  String?   @map("destination_country") @db.VarChar(2)
  plannedBudget  Decimal?  @map("planned_budget") @db.Decimal(10, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle      UserVehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  travelGroup  TravelGroup? @relation(fields: [travelGroupId], references: [id], onDelete: Restrict)
  stops            TripStop[]
  route            TripRoute?
  /// Source de vérité budget voyage (miroir : planned_budget).
  budget           TripBudget?
  expenses         Expense[]
  travelerProfile  TripTravelerProfile?
  tripActivities   TripActivity[]
  locations        TripLocation[]
  aiConversations         AiConversation[]
  aiUsages                AiUsage[]
  aiVoiceSessions         AiVoiceSession[]
  aiTripPlanningSessions  AiTripPlanningSession[]

  @@index([userId, status])
  @@index([vehicleId])
  @@index([travelGroupId])
  @@index([departureDate])
  @@index([deletedAt])
  @@map("trips")
}

/// Points GPS immuables pendant un voyage in_progress (purge hard à la clôture).
model TripLocation {
  id            String   @id @default(uuid(4)) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  /// UUID généré côté client — idempotence retries / flush hors ligne.
  clientPointId String   @map("client_point_id") @db.Uuid
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  accuracyM     Decimal? @map("accuracy_m") @db.Decimal(10, 2)
  heading       Decimal? @db.Decimal(6, 2)
  speedMps      Decimal? @map("speed_mps") @db.Decimal(8, 3)
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tripId, clientPointId])
  @@index([tripId, recordedAt])
  @@index([userId, recordedAt])
  @@map("trip_locations")
}

/// Profil voyageurs / préférences d'activités (suggestions Places).
model TripTravelerProfile {
  id                     String   @id @default(uuid(4)) @db.Uuid
  tripId                 String   @unique @map("trip_id") @db.Uuid
  /// solo | couple | family | friends | business
  purpose                String   @db.VarChar(20)
  adultCount             Int      @map("adult_count")
  childCount             Int      @default(0) @map("child_count")
  /// Ages exacts [0..17], longueur = child_count.
  childAges              Json     @default("[]") @map("child_ages")
  /// ActivityInterest[]
  interests              Json     @default("[]")
  /// free | budget | moderate | any
  budgetPreference       String?  @map("budget_preference") @db.VarChar(20)
  /// under_1h | 1_2h | 2_4h | half_day | any
  durationPreference     String?  @map("duration_preference") @db.VarChar(20)
  maxDetourMinutes       Int      @default(15) @map("max_detour_minutes")
  /// indoor | outdoor | both
  environmentPreference  String?  @map("environment_preference") @db.VarChar(20)
  /// very_low | low | moderate | high
  activityLevel          String?  @map("activity_level") @db.VarChar(20)
  /// mobility | stroller | none[]
  accessibilityNeeds     Json     @default("[]") @map("accessibility_needs")
  travelingWithPet       Boolean  @default(false) @map("traveling_with_pet")
  /// true si l'utilisateur a choisi « Je déciderai plus tard »
  deferred               Boolean  @default(false)
  suggestionsGeneratedAt DateTime? @map("suggestions_generated_at") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_traveler_profiles")
}

/// Activité suggérée / planifiée pour un voyage (Google Places).
model TripActivity {
  id                     String    @id @default(uuid(4)) @db.Uuid
  tripId                 String    @map("trip_id") @db.Uuid
  googlePlaceId          String    @map("google_place_id") @db.VarChar(255)
  /// suggested | saved | added_to_trip | rejected | completed
  status                 String    @default("suggested") @db.VarChar(30)
  name                   String    @db.VarChar(300)
  address                String?   @db.Text
  city                   String?   @db.VarChar(120)
  latitude               Decimal   @db.Decimal(10, 7)
  longitude              Decimal   @db.Decimal(10, 7)
  primaryType            String?   @map("primary_type") @db.VarChar(80)
  types                  Json?
  rating                 Decimal?  @db.Decimal(3, 2)
  reviewCount            Int?      @map("review_count")
  priceLevel             String?   @map("price_level") @db.VarChar(40)
  websiteUrl             String?   @map("website_url") @db.Text
  googleMapsUrl          String?   @map("google_maps_url") @db.Text
  photoReference         String?   @map("photo_reference") @db.Text
  /// destination | along_route | stop | return
  suggestedForSegment    String?   @map("suggested_for_segment") @db.VarChar(40)
  routePositionKm        Decimal?  @map("route_position_km") @db.Decimal(10, 2)
  detourDistanceKm       Decimal?  @map("detour_distance_km") @db.Decimal(10, 2)
  detourDurationMinutes  Int?      @map("detour_duration_minutes")
  estimatedVisitMinutes  Int?      @map("estimated_visit_minutes")
  suitabilityScore       Decimal?  @map("suitability_score") @db.Decimal(5, 2)
  suitabilityReasons     Json?     @map("suitability_reasons")
  warningReasons         Json?     @map("warning_reasons")
  /// reject reason when status=rejected
  rejectReason           String?   @map("reject_reason") @db.VarChar(80)
  plannedDate            DateTime? @map("planned_date") @db.Timestamptz(6)
  plannedStartTime       DateTime? @map("planned_start_time") @db.Timestamptz(6)
  plannedEndTime         DateTime? @map("planned_end_time") @db.Timestamptz(6)
  sequence               Int?
  /// trip_stop créé lors de l'ajout comme arrêt routier
  linkedStopId           String?   @map("linked_stop_id") @db.Uuid
  /// outbound | destination | return | day
  insertPlacement        String?   @map("insert_placement") @db.VarChar(30)
  rawMetadata            Json?     @map("raw_metadata")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, googlePlaceId])
  @@index([tripId, status])
  @@index([tripId, suitabilityScore])
  @@map("trip_activities")
}

/// Étape / waypoint d'itinéraire (détour, activité, etc.) — jamais destination finale.
/// La destination canonique reste sur Trip.destination* ; les fuel stops ne sont pas persistés ici.
model TripStop {
  id              String    @id @default(uuid(4)) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  sequence        Int
  name            String    @db.VarChar(200)
  /// Lieu / adresse en texte (pas de géocodage à cette étape).
  address         String?   @db.Text
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  arrivalTime     DateTime? @map("arrival_time") @db.Timestamptz(6)
  departureTime   DateTime? @map("departure_time") @db.Timestamptz(6)
  /// detour | pass_through | activity | lodging | camping | rest | stop | other
  stopType        String    @default("stop") @map("stop_type") @db.VarChar(50)
  /// outbound = aller ; return = retour (indépendant de l'aller).
  direction       String    @default("outbound") @db.VarChar(20)
  placeId         String?   @map("place_id") @db.VarChar(255)
  /// Durée facultative sur place (minutes) — impacte la durée totale du voyage.
  durationMinutes Int       @default(0) @map("duration_minutes")
  notes           String?   @db.Text
  /// Camping planifié pour la nuit (Doc 4 — trip_stops → campgrounds).
  campgroundId    String?   @map("campground_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip           Trip               @relation(fields: [tripId], references: [id], onDelete: Restrict)
  campground     Campground?        @relation(fields: [campgroundId], references: [id], onDelete: Restrict)
  stopActivities TripStopActivity[]

  @@unique([tripId, direction, sequence])
  @@index([tripId, sequence])
  @@index([tripId, direction, sequence])
  @@index([campgroundId])
  @@map("trip_stops")
}

/// Répertoire local de campings (Doc 4 §8) — fournisseur local / seed-dev / admin.
model Campground {
  id             String    @id @default(uuid(4)) @db.Uuid
  name           String    @db.VarChar(200)
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  address        String?   @db.VarChar(300)
  city           String?   @db.VarChar(120)
  region         String?   @db.VarChar(120)
  countryCode    String    @default("CA") @map("country_code") @db.Char(2)
  /// rv_park | campground | dump_station | overnight | other
  campgroundType String    @default("campground") @map("campground_type") @db.VarChar(50)
  maxLengthM     Decimal?  @map("max_length_m") @db.Decimal(6, 2)
  /// Services : electricity, water, dump_station, wifi, propane, sewer…
  services       Json      @default("[]")
  petFriendly    Boolean   @default(false) @map("pet_friendly")
  rating         Decimal?  @db.Decimal(3, 2)
  priceMin       Decimal?  @map("price_min") @db.Decimal(8, 2)
  priceMax       Decimal?  @map("price_max") @db.Decimal(8, 2)
  reservationUrl String?   @map("reservation_url") @db.Text
  /// manual | import | seed-dev (jamais en prod)
  source         String    @default("manual") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  stops     TripStop[]
  favorites UserCampgroundFavorite[]

  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([source])
  @@index([petFriendly])
  @@index([campgroundType])
  @@map("campgrounds")
}

/// Favoris camping par utilisateur (Doc 10 Partie 15).
model UserCampgroundFavorite {
  id           String    @id @default(uuid(4)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  campgroundId String    @map("campground_id") @db.Uuid
  notes        String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Restrict)

  @@unique([userId, campgroundId])
  @@index([userId])
  @@index([campgroundId])
  @@index([deletedAt])
  @@map("user_campground_favorites")
}

/// Répertoire local activités / POI unifiés (Doc 4 §8 + écarts plan Partie 16).
model Activity {
  id                    String    @id @default(uuid(4)) @db.Uuid
  name                  String    @db.VarChar(200)
  /// activity | poi
  kind                  String    @default("activity") @db.VarChar(20)
  /// parc, musee, plage, randonnee, restaurant, cascade, belvedere, autre…
  category              String    @db.VarChar(60)
  latitude              Decimal   @db.Decimal(10, 7)
  longitude             Decimal   @db.Decimal(10, 7)
  address               String?   @db.VarChar(300)
  city                  String?   @db.VarChar(120)
  region                String?   @db.VarChar(120)
  countryCode           String    @default("CA") @map("country_code") @db.Char(2)
  familyScore           Int?      @map("family_score")
  petFriendly           Boolean   @default(false) @map("pet_friendly")
  estimatedDurationMin  Int?      @map("estimated_duration_min")
  /// Prix indicatif CAD (écart Doc 4).
  priceIndicative       Decimal?  @map("price_indicative") @db.Decimal(8, 2)
  /// Saisons couvertes JSONB ex. ["summer","fall"] (écart Doc 4).
  season                Json      @default("[]")
  description           String?   @db.Text
  rating                Decimal?  @db.Decimal(3, 2)
  website               String?   @db.Text
  /// manual | import | seed-dev (jamais en prod)
  source                String    @default("manual") @db.VarChar(50)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  favorites      UserActivityFavorite[]
  stopActivities TripStopActivity[]

  @@index([latitude, longitude])
  @@index([category, city])
  @@index([kind])
  @@index([deletedAt])
  @@index([source])
  @@index([petFriendly])
  @@map("activities")
}

/// Favoris activité / POI par utilisateur (Doc 10 Partie 16).
model UserActivityFavorite {
  id         String    @id @default(uuid(4)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  activityId String    @map("activity_id") @db.Uuid
  notes      String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([deletedAt])
  @@map("user_activity_favorites")
}

/// Liaison N:N étape ↔ activités (plusieurs activités par étape).
model TripStopActivity {
  id         String    @id @default(uuid(4)) @db.Uuid
  tripStopId String    @map("trip_stop_id") @db.Uuid
  activityId String    @map("activity_id") @db.Uuid
  sequence   Int       @default(1)
  notes      String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  tripStop TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([tripStopId, activityId])
  @@index([tripStopId, sequence])
  @@index([activityId])
  @@index([deletedAt])
  @@map("trip_stop_activities")
}

/// Tracé / estimations 1:1 — Google Maps (Partie 12) / carburant (Partie 13).
model TripRoute {
  id                          String   @id @default(uuid(4)) @db.Uuid
  tripId                      String   @unique @map("trip_id") @db.Uuid
  provider                    String?  @db.VarChar(50)
  distanceKm                  Decimal? @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMin        Int?     @map("estimated_duration_min")
  estimatedFuelCost           Decimal? @map("estimated_fuel_cost") @db.Decimal(10, 2)
  polyline                    String?  @db.Text
  /// Trajet retour distinct (destination → waypoints return → origin).
  returnDistanceKm            Decimal? @map("return_distance_km") @db.Decimal(10, 2)
  returnEstimatedDurationMin  Int?     @map("return_estimated_duration_min")
  returnPolyline              String?  @map("return_polyline") @db.Text
  /// Hash des waypoints au moment du calcul — périmé si les étapes changent.
  waypointsHash               String?  @map("waypoints_hash") @db.VarChar(64)
  /// Snapshot des specs véhicule utilisées pour le dernier calcul / voyage terminé.
  vehicleSpecsSnapshot        Json?    @map("vehicle_specs_snapshot") @db.JsonB
  /// true si le véhicule a changé depuis le dernier calcul (voyages planned / in_progress).
  fuelEstimateStale           Boolean  @default(false) @map("fuel_estimate_stale")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@map("trip_routes")
}

/// Budget prévu d'un voyage — source de vérité (Doc 4 §9).
/// `trips.planned_budget` est un miroir synchronisé uniquement via
/// `upsertTripBudgetAmount` (feature finance).
model TripBudget {
  id            String   @id @default(uuid(4)) @db.Uuid
  tripId        String   @unique @map("trip_id") @db.Uuid
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(10, 2)
  currency      String   @default("CAD") @db.Char(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@map("trip_budgets")
}

/// Dépense liée à un voyage (ledger financier — Doc 4 §9).
model Expense {
  id              String    @id @default(uuid(4)) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  /// fuel | camping | activity | food | lodging | toll | maintenance | other
  category        String    @db.VarChar(50)
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("CAD") @db.Char(3)
  expenseDate     DateTime  @map("expense_date") @db.Date
  merchant        String?   @db.VarChar(200)
  notes           String?   @db.Text
  /// Import depuis fuel_logs — unique quand non-null (anti-double-ajout).
  sourceFuelLogId String?   @unique @map("source_fuel_log_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Restrict)
  sourceFuelLog FuelLog?         @relation(fields: [sourceFuelLogId], references: [id], onDelete: Restrict)
  receipts      ExpenseReceipt[]

  @@index([tripId, expenseDate])
  @@index([category])
  @@index([deletedAt])
  @@map("expenses")
}

/// Reçu lié à une dépense (URL — OCR hors scope).
model ExpenseReceipt {
  id        String   @id @default(uuid(4)) @db.Uuid
  expenseId String   @map("expense_id") @db.Uuid
  fileUrl   String   @map("file_url") @db.Text
  ocrJson   Json?    @map("ocr_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@map("expense_receipts")
}

/// Notification in-app (centre) — Doc 4 users 1→N notifications (schéma détaillé
/// non spécifié ; écart assumé). Canaux email/push réservés (channel uniquement).
/// Unique partielle (user_id, channel, dedupe_key) WHERE deleted_at IS NULL
/// créée en SQL dans la migration (anti-doublon + soft-delete).
model Notification {
  id           String    @id @default(uuid(4)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// maintenance | trip | budget | weather | fuel
  type         String    @db.VarChar(30)
  /// in_app | email | push — in_app + email honorés ; push réservé
  channel      String    @default("in_app") @db.VarChar(20)
  title        String    @db.VarChar(200)
  body         String    @db.Text
  /// low | normal | high
  priority     String    @default("normal") @db.VarChar(20)
  dedupeKey    String    @map("dedupe_key") @db.VarChar(255)
  sourceEntity String?   @map("source_entity") @db.VarChar(100)
  sourceId     String?   @map("source_id") @db.Uuid
  href         String?   @db.VarChar(500)
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
  @@index([type])
  @@map("notifications")
}

/// Préférences de canaux/types — Doc 6 notification-preferences.
/// in_app_* + email_* honorés ; push_* réservés pour phase Push.
model NotificationPreference {
  userId            String   @id @map("user_id") @db.Uuid
  inAppMaintenance  Boolean  @default(true) @map("in_app_maintenance")
  inAppTrip         Boolean  @default(true) @map("in_app_trip")
  inAppBudget       Boolean  @default(true) @map("in_app_budget")
  inAppWeather      Boolean  @default(true) @map("in_app_weather")
  inAppFuel         Boolean  @default(true) @map("in_app_fuel")
  emailMaintenance  Boolean  @default(false) @map("email_maintenance")
  emailTrip         Boolean  @default(false) @map("email_trip")
  emailBudget       Boolean  @default(false) @map("email_budget")
  emailWeather      Boolean  @default(false) @map("email_weather")
  emailFuel         Boolean  @default(false) @map("email_fuel")
  pushMaintenance   Boolean  @default(false) @map("push_maintenance")
  pushTrip          Boolean  @default(false) @map("push_trip")
  pushBudget        Boolean  @default(false) @map("push_budget")
  pushWeather       Boolean  @default(false) @map("push_weather")
  pushFuel          Boolean  @default(false) @map("push_fuel")
  /// Délai (jours) avant échéance pour notifier un entretien.
  maintenanceLeadDays Int @default(30) @map("maintenance_lead_days")
  /// Délai (km) avant échéance pour notifier un entretien.
  maintenanceLeadKm   Int @default(500) @map("maintenance_lead_km")
  /// Fréquence minimale entre deux rappels pour la même échéance (jours).
  maintenanceReminderFrequencyDays Int @default(7) @map("maintenance_reminder_frequency_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("notification_preferences")
}

/// Projection locale d'un client Stripe (Phase 3). Unique active (userId, stripeMode) en SQL.
model StripeCustomer {
  id               String    @id @default(uuid(4)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  stripeCustomerId String    @map("stripe_customer_id") @db.VarChar(255)
  /// test | live — jamais déduit uniquement du préfixe de clé
  stripeMode       String    @map("stripe_mode") @db.VarChar(10)
  emailSnapshot    String?   @map("email_snapshot") @db.VarChar(255)
  nameSnapshot     String?   @map("name_snapshot") @db.VarChar(255)
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(6)
  stripeUpdatedAt  DateTime? @map("stripe_updated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([stripeCustomerId, stripeMode])
  @@index([userId])
  @@index([stripeMode])
  @@index([deletedAt])
  @@map("stripe_customers")
}

/// Projection locale d'un abonnement Stripe (source de vérité = Stripe).
model StripeSubscription {
  id                   String    @id @default(uuid(4)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  stripeCustomerId     String    @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String    @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?   @map("stripe_price_id") @db.VarChar(255)
  stripeProductId      String?   @map("stripe_product_id") @db.VarChar(255)
  /// Statut Stripe brut (string) — ne pas forcer active si inconnu
  status               String    @db.VarChar(40)
  currency             String?   @db.VarChar(10)
  /// Montant unitaire en cents
  unitAmount           Int?      @map("unit_amount")
  billingInterval      String?   @map("billing_interval") @db.VarChar(20)
  quantity             Int       @default(1)
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  cancelAt             DateTime? @map("cancel_at") @db.Timestamptz(6)
  canceledAt           DateTime? @map("canceled_at") @db.Timestamptz(6)
  trialStart           DateTime? @map("trial_start") @db.Timestamptz(6)
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz(6)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(6)
  latestInvoiceId      String?   @map("latest_invoice_id") @db.VarChar(255)
  stripeMode           String    @map("stripe_mode") @db.VarChar(10)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(6)
  stripeUpdatedAt      DateTime? @map("stripe_updated_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([stripeSubscriptionId, stripeMode])
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([stripeMode])
  @@index([currentPeriodEnd])
  @@index([createdAt])
  @@map("stripe_subscriptions")
}

/// Projection locale d'un PaymentIntent / paiement Stripe.
model StripePayment {
  id                     String    @id @default(uuid(4)) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  stripeCustomerId       String?   @map("stripe_customer_id") @db.VarChar(255)
  stripePaymentIntentId  String    @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeChargeId         String?   @map("stripe_charge_id") @db.VarChar(255)
  stripeInvoiceId        String?   @map("stripe_invoice_id") @db.VarChar(255)
  /// Montants en cents
  amount                 Int
  amountReceived         Int       @default(0) @map("amount_received")
  amountRefunded         Int       @default(0) @map("amount_refunded")
  currency               String    @db.VarChar(10)
  status                 String    @db.VarChar(40)
  failureCode            String?   @map("failure_code") @db.VarChar(100)
  failureMessageSafe     String?   @map("failure_message_safe") @db.Text
  paymentMethodType      String?   @map("payment_method_type") @db.VarChar(40)
  cardBrand              String?   @map("card_brand") @db.VarChar(40)
  cardLast4              String?   @map("card_last4") @db.VarChar(4)
  cardExpMonth           Int?      @map("card_exp_month")
  cardExpYear            Int?      @map("card_exp_year")
  stripeMode             String    @map("stripe_mode") @db.VarChar(10)
  paidAt                 DateTime? @map("paid_at") @db.Timestamptz(6)
  lastSyncedAt           DateTime? @map("last_synced_at") @db.Timestamptz(6)
  stripeUpdatedAt        DateTime? @map("stripe_updated_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds StripeRefund[]

  @@unique([stripePaymentIntentId, stripeMode])
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([stripeMode])
  @@index([createdAt])
  @@map("stripe_payments")
}

/// Projection locale d'une facture Stripe.
model StripeInvoice {
  id                   String    @id @default(uuid(4)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  stripeCustomerId     String?   @map("stripe_customer_id") @db.VarChar(255)
  stripeInvoiceId      String    @map("stripe_invoice_id") @db.VarChar(255)
  stripeSubscriptionId String?   @map("stripe_subscription_id") @db.VarChar(255)
  number               String?   @db.VarChar(100)
  status               String?   @db.VarChar(40)
  currency             String?   @db.VarChar(10)
  /// Montants en cents
  subtotal             Int       @default(0)
  tax                  Int       @default(0)
  total                Int       @default(0)
  amountPaid           Int       @default(0) @map("amount_paid")
  amountDue            Int       @default(0) @map("amount_due")
  amountRemaining      Int       @default(0) @map("amount_remaining")
  hostedInvoiceUrl     String?   @map("hosted_invoice_url") @db.Text
  invoicePdfUrl        String?   @map("invoice_pdf_url") @db.Text
  periodStart          DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd            DateTime? @map("period_end") @db.Timestamptz(6)
  dueDate              DateTime? @map("due_date") @db.Timestamptz(6)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  voidedAt             DateTime? @map("voided_at") @db.Timestamptz(6)
  stripeMode           String    @map("stripe_mode") @db.VarChar(10)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(6)
  stripeUpdatedAt      DateTime? @map("stripe_updated_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([stripeInvoiceId, stripeMode])
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([stripeMode])
  @@index([createdAt])
  @@map("stripe_invoices")
}

/// Projection locale d'un remboursement Stripe.
model StripeRefund {
  id                    String    @id @default(uuid(4)) @db.Uuid
  paymentId             String    @map("payment_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  stripeRefundId        String    @map("stripe_refund_id") @db.VarChar(255)
  stripePaymentIntentId String?   @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeChargeId        String?   @map("stripe_charge_id") @db.VarChar(255)
  /// Montant en cents
  amount                Int
  currency              String    @db.VarChar(10)
  status                String    @db.VarChar(40)
  /// Raison normalisée Stripe (duplicate, fraudulent, requested_by_customer, …)
  stripeReason          String?   @map("stripe_reason") @db.VarChar(60)
  /// Justification administrative interne
  adminReason           String?   @map("admin_reason") @db.Text
  createdByAdminId      String?   @map("created_by_admin_id") @db.Uuid
  stripeMode            String    @map("stripe_mode") @db.VarChar(10)
  lastSyncedAt          DateTime? @map("last_synced_at") @db.Timestamptz(6)
  stripeUpdatedAt       DateTime? @map("stripe_updated_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment         StripePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  user            User          @relation("StripeRefundUser", fields: [userId], references: [id], onDelete: Restrict)
  createdByAdmin  User?         @relation("StripeRefundAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@unique([stripeRefundId, stripeMode])
  @@index([paymentId])
  @@index([userId])
  @@index([createdByAdminId])
  @@index([status])
  @@index([stripeMode])
  @@index([createdAt])
  @@map("stripe_refunds")
}

/// Registre idempotent des événements webhook Stripe (pas de payload complet).
model StripeWebhookEvent {
  id                   String    @id @default(uuid(4)) @db.Uuid
  stripeEventId        String    @map("stripe_event_id") @db.VarChar(255)
  stripeMode           String    @map("stripe_mode") @db.VarChar(10)
  type                 String    @db.VarChar(120)
  apiVersion           String?   @map("api_version") @db.VarChar(40)
  objectId             String?   @map("object_id") @db.VarChar(255)
  /// received | processing | processed | ignored | failed
  status               String    @db.VarChar(20)
  attemptCount         Int       @default(0) @map("attempt_count")
  receivedAt           DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processingStartedAt  DateTime? @map("processing_started_at") @db.Timestamptz(6)
  processedAt          DateTime? @map("processed_at") @db.Timestamptz(6)
  lastErrorCode        String?   @map("last_error_code") @db.VarChar(80)
  lastErrorSafe        String?   @map("last_error_safe") @db.Text
  nextRetryAt          DateTime? @map("next_retry_at") @db.Timestamptz(6)
  payloadHash          String    @map("payload_hash") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([stripeEventId, stripeMode])
  @@index([status])
  @@index([type])
  @@index([stripeMode])
  @@index([receivedAt])
  @@index([objectId])
  @@map("stripe_webhook_events")
}

/// Forfait commercial Sebavio (métadonnées locales + lien produit Stripe).
model Plan {
  id                  String    @id @default(uuid(4)) @db.Uuid
  /// Clé interne stable (slug) — unique par mode
  internalName        String    @map("internal_name") @db.VarChar(100)
  /// Nom affiché aux utilisateurs
  publicName          String    @map("public_name") @db.VarChar(150)
  shortDescription    String?   @map("short_description") @db.VarChar(500)
  fullDescription     String?   @map("full_description") @db.Text
  displayOrder        Int       @default(0) @map("display_order")
  isFeatured          Boolean   @default(false) @map("is_featured")
  /// Visible sur les écrans d’inscription / pricing publics
  isVisibleOnSignup   Boolean   @default(true) @map("is_visible_on_signup")
  /// Forfait officiel protégé contre suppression accidentelle
  isSystemProtected   Boolean   @default(false) @map("is_system_protected")
  /// active | hidden | archived | pending_reconciliation
  status              String    @db.VarChar(40)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  /// Essai commercial (jours) — appliqué à Checkout / création d’abonnement, PAS une propriété Price Stripe
  defaultTrialDays    Int?      @map("default_trial_days")
  stripeProductId     String?   @map("stripe_product_id") @db.VarChar(255)
  /// test | live — aligné sur StripeMode projet
  stripeMode          String    @map("stripe_mode") @db.VarChar(10)
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  /// Dernière erreur de réconciliation (message sûr, sans secrets)
  reconciliationError String?   @map("reconciliation_error") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices       PlanPrice[]
  entitlements PlanEntitlement[]
  purchases    PlanPurchase[]
  accessGrants PlanAccessGrant[]

  @@unique([stripeProductId, stripeMode])
  @@unique([internalName, stripeMode])
  @@index([status])
  @@index([stripeMode])
  @@index([displayOrder])
  @@index([isVisibleOnSignup])
  @@map("plans")
}

/// Miroir local d’un Price Stripe (immuable en montant une fois créé).
model PlanPrice {
  id                 String    @id @default(uuid(4)) @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  stripePriceId      String    @map("stripe_price_id") @db.VarChar(255)
  /// recurring | one_time
  billingType        String    @default("recurring") @map("billing_type") @db.VarChar(20)
  /// day | week | month | year | one_time (sentinel pour achat unique)
  interval           String    @db.VarChar(20)
  /// Nombre d’intervalles (ex. 1 = mensuel, 1 annuel ; extensible)
  intervalCount      Int       @default(1) @map("interval_count")
  /// Durée d’accès en jours pour un prix one_time (ex. Pass 30 jours)
  accessDurationDays Int?      @map("access_duration_days")
  currency           String    @db.VarChar(10)
  /// Montant en cents (source Stripe)
  unitAmount         Int       @map("unit_amount")
  /// active | archived (miroir / décision Sebavio pour nouveaux abonnés)
  status             String    @db.VarChar(20)
  /// Un seul true par (planId, interval, intervalCount, currency) — index partiel SQL
  isCurrent          Boolean   @default(false) @map("is_current")
  /// test | live
  stripeMode         String    @map("stripe_mode") @db.VarChar(10)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  purchases PlanPurchase[]

  @@unique([stripePriceId, stripeMode])
  @@index([planId])
  @@index([stripeMode])
  @@index([status])
  @@index([billingType])
  @@index([planId, interval, intervalCount, currency])
  @@map("plan_prices")
}

/// Achat unique (Checkout payment mode) — ex. Pass 30 jours.
model PlanPurchase {
  id                      String    @id @default(uuid(4)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  planId                  String    @map("plan_id") @db.Uuid
  planPriceId             String    @map("plan_price_id") @db.Uuid
  /// pending_payment | paid | failed | refunded
  status                  String    @db.VarChar(40)
  stripeCheckoutSessionId String?   @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id") @db.VarChar(255)
  /// Événement Stripe ayant activé l’achat (idempotence)
  activationStripeEventId String?   @map("activation_stripe_event_id") @db.VarChar(255)
  amountCents             Int       @map("amount_cents")
  currency                String    @db.VarChar(10)
  stripeMode              String    @map("stripe_mode") @db.VarChar(10)
  paidAt                  DateTime? @map("paid_at") @db.Timestamptz(6)
  refundedAt              DateTime? @map("refunded_at") @db.Timestamptz(6)
  /// Contexte optionnel (ex. tripId) pour retour post-paiement
  returnContext           Json?     @map("return_context") @db.JsonB
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan        Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice   PlanPrice        @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  accessGrant PlanAccessGrant?

  @@unique([stripeCheckoutSessionId, stripeMode])
  @@unique([activationStripeEventId, stripeMode])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([stripeMode])
  @@index([createdAt])
  @@map("plan_purchases")
}

/// Droit d’accès temporaire (Pass) — prolongement possible sans perdre les jours restants.
model PlanAccessGrant {
  id                    String    @id @default(uuid(4)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  planId                String    @map("plan_id") @db.Uuid
  sourcePurchaseId      String?   @unique @map("source_purchase_id") @db.Uuid
  /// pending_payment | active | expired | refunded | revoked | payment_failed
  status                String    @db.VarChar(40)
  startsAt              DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime  @map("ends_at") @db.Timestamptz(6)
  /// Dernier événement Stripe ayant prolongé / activé (anti double-prolongation)
  lastExtensionEventId  String?   @map("last_extension_event_id") @db.VarChar(255)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason         String?   @map("revoked_reason") @db.Text
  revokedByAdminId      String?   @map("revoked_by_admin_id") @db.Uuid
  lastAdminExtendAt     DateTime? @map("last_admin_extend_at") @db.Timestamptz(6)
  lastAdminExtendById   String?   @map("last_admin_extend_by_id") @db.Uuid
  lastAdminExtendDays   Int?      @map("last_admin_extend_days")
  lastAdminExtendReason String?   @map("last_admin_extend_reason") @db.Text
  stripeMode            String    @map("stripe_mode") @db.VarChar(10)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan              Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  sourcePurchase    PlanPurchase? @relation(fields: [sourcePurchaseId], references: [id], onDelete: Restrict)
  revokedByAdmin    User?         @relation("PlanAccessGrantRevoker", fields: [revokedByAdminId], references: [id], onDelete: Restrict)
  lastAdminExtendBy User?         @relation("PlanAccessGrantExtender", fields: [lastAdminExtendById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endsAt])
  @@index([stripeMode])
  @@index([userId, planId, status])
  @@map("plan_access_grants")
}

/// Entitlement / limite associée à un forfait (clés du registre typé uniquement).
model PlanEntitlement {
  id        String   @id @default(uuid(4)) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  /// Clé du registre typé uniquement
  key       String   @db.VarChar(100)
  enabled   Boolean  @default(false)
  /// null = illimité si enabled ; sinon limite numérique (>= 0)
  limit     Int?
  /// Valeur libre optionnelle (ex. niveau support)
  value     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, key])
  @@index([key])
  @@map("plan_entitlements")
}

/// Run d’idempotence durable pour applyPlanSync (preview / applying / completed / failed).
model PlanSyncRun {
  id          String    @id @default(uuid(4)) @db.Uuid
  /// test | live
  stripeMode  String    @map("stripe_mode") @db.VarChar(10)
  /// preview | applying | completed | failed
  status      String    @db.VarChar(30)
  report      Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  actions PlanSyncAction[]

  @@index([stripeMode])
  @@index([status])
  @@map("plan_sync_runs")
}

/// Action atomique d’un PlanSyncRun (idempotence par action_key).
model PlanSyncAction {
  id         String   @id @default(uuid(4)) @db.Uuid
  syncRunId  String   @map("sync_run_id") @db.Uuid
  actionKey  String   @map("action_key") @db.VarChar(255)
  actionType String   @map("action_type") @db.VarChar(50)
  /// pending | applied | skipped | failed
  status     String   @db.VarChar(30)
  payload    Json?    @db.JsonB
  result     Json?    @db.JsonB
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  syncRun PlanSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@unique([syncRunId, actionKey])
  @@index([status])
  @@map("plan_sync_actions")
}

/// Conversation assistant IA liée à un voyage (Phase IA 1).
model AiConversation {
  id        String   @id @default(uuid(4)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip     Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@unique([userId, tripId])
  @@index([tripId])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// Message d’une conversation assistant (user | assistant | system).
model AiMessage {
  id                String   @id @default(uuid(4)) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  /// user | assistant | system
  role              String   @db.VarChar(20)
  content           String   @db.Text
  /// Réponse structurée validée Zod (assistant) — JsonB
  structuredPayload Json?    @map("structured_payload") @db.JsonB
  model             String?  @db.VarChar(100)
  promptVersion     String?  @map("prompt_version") @db.VarChar(60)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Métriques d’utilisation IA (sans secrets ni GPS précis).
model AiUsage {
  id           String   @id @default(uuid(4)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tripId       String?  @map("trip_id") @db.Uuid
  /// chat | analyze | suggest_activities | weather | schedule | fuel | apply_action
  requestType  String   @map("request_type") @db.VarChar(40)
  /// xai | openai | mock | demo-static
  provider     String?  @db.VarChar(40)
  model        String?  @db.VarChar(100)
  promptVersion String? @map("prompt_version") @db.VarChar(60)
  /// trip_context | web_grounded
  knowledgeMode String? @map("knowledge_mode") @db.VarChar(40)
  intent       String?  @db.VarChar(60)
  webSearchUsed Boolean @default(false) @map("web_search_used")
  webSearchCallCount Int @default(0) @map("web_search_call_count")
  sourceCount  Int?     @map("source_count")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  totalTokens  Int?     @map("total_tokens")
  durationMs   Int      @map("duration_ms")
  success      Boolean
  errorCode    String?  @map("error_code") @db.VarChar(60)
  /// Slug forfait au moment de la requête (métriques admin)
  planSlug     String?  @map("plan_slug") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
  @@index([requestType, createdAt])
  @@index([success, createdAt])
  @@index([provider, createdAt])
  @@index([webSearchUsed, createdAt])
  @@index([intent, createdAt])
  @@index([createdAt])
  @@map("ai_usages")
}

/// Session vocale agent (Realtime ou pipeline STT/TTS) — pas de secret API stocké.
model AiVoiceSession {
  id                    String    @id @default(uuid(4)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  tripId                String    @map("trip_id") @db.Uuid
  conversationId        String?   @map("conversation_id") @db.Uuid
  /// conversation | driving
  usageMode             String    @default("conversation") @map("usage_mode") @db.VarChar(20)
  /// web | mobile | android_auto | carplay
  clientPlatform        String    @default("web") @map("client_platform") @db.VarChar(40)
  /// openai_realtime | pipeline | mock
  provider              String    @db.VarChar(40)
  status                String    @default("active") @db.VarChar(20)
  pseudonymId           String    @map("pseudonym_id") @db.VarChar(64)
  startedAt             DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt               DateTime? @map("ended_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  userAudioSeconds      Int       @default(0) @map("user_audio_seconds")
  assistantAudioSeconds Int       @default(0) @map("assistant_audio_seconds")
  durationSeconds       Int       @default(0) @map("duration_seconds")
  interruptionCount     Int       @default(0) @map("interruption_count")
  errorCount            Int       @default(0) @map("error_count")
  endReason             String?   @map("end_reason") @db.VarChar(60)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([tripId, startedAt])
  @@index([expiresAt])
  @@map("ai_voice_sessions")
}

/// Événements de metering vocal (session_start | session_end | heartbeat | error).
model AiVoiceUsage {
  id             String   @id @default(uuid(4)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  tripId         String?  @map("trip_id") @db.Uuid
  /// session_start | session_end | heartbeat | error
  eventType      String   @map("event_type") @db.VarChar(40)
  secondsDelta   Int      @default(0) @map("seconds_delta")
  planSlug       String?  @map("plan_slug") @db.VarChar(100)
  provider       String?  @db.VarChar(40)
  clientPlatform String?  @map("client_platform") @db.VarChar(40)
  usageMode      String?  @map("usage_mode") @db.VarChar(20)
  errorCode      String?  @map("error_code") @db.VarChar(60)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_voice_usages")
}

/// Session de planification de voyage guidée par l’IA (« Planifier avec l’IA »).
model AiTripPlanningSession {
  id              String    @id @default(uuid(4)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// collecting | proposing | ready_for_confirmation | created | abandoned
  status          String    @default("collecting") @db.VarChar(40)
  messages        Json      @db.JsonB
  structuredDraft Json      @map("structured_draft") @db.JsonB
  createdTripId   String?   @map("created_trip_id") @db.Uuid
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdTrip Trip? @relation(fields: [createdTripId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([createdTripId])
  @@map("ai_trip_planning_sessions")
}
