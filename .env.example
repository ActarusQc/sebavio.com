# Environment variables — Sebavio
# Copy this file to `.env` (never commit `.env`) and fill in real values on the server.
# Development runs on the Contabo "développement" environment.

# --- Immediate ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3050

# PostgreSQL (Prisma) — server-only
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sebavio_dev

# Mot de passe des comptes créés par `npm run prisma:seed` (dev uniquement)
SEED_PASSWORD=

# Redis — server-only (rate-limiting auth : échec fermé si indisponible)
REDIS_URL=

# --- Auth.js ---
AUTH_SECRET=
AUTH_URL=http://localhost:3050

# --- Google Maps (Partie 12) ---
# Clé SERVEUR : Geocoding API + Directions API uniquement.
# Restriction Google Cloud recommandée : adresses IP du VPS Contabo.
# Ne jamais exposer cette clé au client.
GOOGLE_MAPS_API_KEY=

# Clé CLIENT (affichage carte uniquement) :
# DOIT être restreinte dans Google Cloud à « Maps JavaScript API » SEULEMENT.
# Ne jamais activer Geocoding ni Directions sur cette clé (coûts + surface d'attaque).
# Restriction HTTP referrer recommandée :
#   http://localhost:3050/*
#   https://dev.votredomaine/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID optionnel (Cloud Console → Map Management) pour styles / Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# --- Météo (Partie 14) ---
# open-meteo (défaut) | off | openweather (non implémenté → mode dégradé)
WEATHER_PROVIDER=open-meteo
# Clé offre commerciale Open-Meteo (customer-api). Vide = endpoint public
# non-commercial — souscrire avant tout lancement commercial SaaS.
OPEN_METEO_API_KEY=

# --- Régie Essence Québec (Partie 13bis) ---
# URL Excel directe (optionnel). Si vide, résolution via
# https://regieessencequebec.ca/stations.geojson.gz → metadata.excel_url
REGIE_ESSENCE_XLSX_URL=

# --- Stripe (phase ultérieure) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AI providers (phase ultérieure) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
