# Environment variables — Sebavio
# Copy this file to `.env` (never commit `.env`) and fill in real values on the server.
# Development runs on the Contabo "développement" environment.

# --- Immediate ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://dev.example.com

# PostgreSQL (Prisma) — server-only
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sebavio_dev

# Mot de passe des comptes créés par `npm run prisma:seed` (dev uniquement)
SEED_PASSWORD=

# Redis — server-only
REDIS_URL=redis://127.0.0.1:6379/0


# --- Auth.js (phase ultérieure) ---
AUTH_SECRET=replace-with-long-random-secret

# --- Google Maps (phase ultérieure) ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# --- Stripe (phase ultérieure) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AI providers (phase ultérieure) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
