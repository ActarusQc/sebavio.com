# Environment variables — Sebavio
# Copy this file to `.env` (never commit `.env`) and fill in real values on the server.
# Development runs on the Contabo "développement" environment.

# --- Immediate ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3050

# PostgreSQL (Prisma) — server-only
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sebavio_dev

# Mot de passe des comptes créés par `npm run prisma:seed` (dev uniquement)
SEED_PASSWORD=

# Redis — server-only (rate-limiting auth : échec fermé si indisponible)
REDIS_URL=

# --- Auth.js ---
AUTH_SECRET=
AUTH_URL=http://localhost:3050

# --- Google Maps (Partie 12) ---
# Clé SERVEUR : Geocoding + Directions + Places API (New) Nearby Search.
# Restriction Google Cloud recommandée : adresses IP du VPS Contabo.
# Obligatoire pour les stations du plan de ravitaillement :
#   activer « Places API (New) » sur cette clé (méthode places.searchNearby).
# Ne jamais exposer cette clé au client.
GOOGLE_MAPS_API_KEY=

# Optionnel : clé dédiée Places API (New) si la clé serveur principale
# ne doit pas exposer Places. Sinon laisser vide (= GOOGLE_MAPS_API_KEY).
GOOGLE_MAPS_PLACES_API_KEY=

# Clé CLIENT (Maps JavaScript API + Places API / Autocomplete) :
# Restriction HTTP referrer obligatoire :
#   http://localhost:3050/*
#   https://sebavio.com/*
#   https://www.sebavio.com/*
# APIs à activer sur cette clé uniquement :
#   - Maps JavaScript API
#   - Places API (New)  [AutocompleteSuggestion + Place Details]
# Ne jamais activer Geocoding ni Directions sur cette clé (coûts + surface d'attaque).
# Ne jamais journaliser la valeur de cette clé.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID optionnel (Cloud Console → Map Management) pour styles / Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# --- Météo (Partie 14) ---
# openweather (recommandé commercial) | open-meteo | off
WEATHER_PROVIDER=openweather
WEATHER_ENABLED=true
# Plafond interne (marge sous 1 000 appels/jour One Call by Call).
WEATHER_MAX_DAILY_CALLS=900
# Rayon de regroupement des étapes proches (km).
WEATHER_CLUSTER_RADIUS_KM=20
WEATHER_TIMEOUT_MS=12000
WEATHER_MAX_RETRIES=2

# OpenWeather — One Call API (serveur uniquement, jamais NEXT_PUBLIC_*)
# Abonnement « One Call by Call » requis (1 000 appels/jour gratuits — à vérifier).
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
# 4 = One Call API 4.0 (modulaire) | 3 = One Call 3.0 (réponse unifiée, 1 appel)
OPENWEATHER_ONECALL_VERSION=4

# Open-Meteo (alternative) — clé commerciale optionnelle (customer-api).
OPEN_METEO_API_KEY=

# --- Campings (Partie 15) ---
# local (défaut) — table campgrounds. Aucun fournisseur externe sans accord.
CAMPGROUND_PROVIDER=local

# --- Activités / POI (Partie 16) ---
# local (défaut) — table activities. Aucun fournisseur externe sans accord.
ACTIVITY_PROVIDER=local

# --- Suggestions d'activités voyage (Places API New, serveur) ---
# google (défaut) | mock (dev uniquement si clé absente)
TRIP_ACTIVITY_PROVIDER=google
# Optionnel : clé dédiée Places serveur. Sinon GOOGLE_MAPS_PLACES_API_KEY
# puis GOOGLE_MAPS_API_KEY. Jamais NEXT_PUBLIC_*.
GOOGLE_PLACES_SERVER_API_KEY=
# Enrichissement IA des descriptions (désactivé par défaut)
TRIP_ACTIVITY_AI_ENHANCEMENT_ENABLED=false

# --- Régie Essence Québec (Partie 13bis) ---
# URL Excel directe (optionnel). Si vide, résolution via
# https://regieessencequebec.ca/stations.geojson.gz → metadata.excel_url
REGIE_ESSENCE_XLSX_URL=

# --- Courriel SMTP (SMTP2GO) ---
# console (défaut en développement) | smtp (défaut en production)
# En développement, laisser console pour zéro consommation de quota
# (liens verify/reset journalisés dans la console serveur).
# Pour tester un envoi réel : EMAIL_PROVIDER=smtp + credentials ci-dessous.
EMAIL_PROVIDER=
# mail.smtp2go.com
SMTP_HOST=
# 587 (STARTTLS) — SMTP_SECURE=false ; 465 si SSL direct
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# OBLIGATOIRE : domaine sebavio.com (vérifié chez SMTP2GO).
# Exemple : Sebavio <no-reply@sebavio.com>
# Jamais une adresse générique du fournisseur (@smtp2go.com, etc.).
EMAIL_FROM=
# Optionnel
EMAIL_REPLY_TO=

# --- Stripe (phase ultérieure) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AI providers (phase ultérieure) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Catalogue véhicules NRCan (cotes de consommation) ---
# Jeu de données officiel : https://open.canada.ca/data/en/dataset/98f1a129-f628-4ce4-b24d-6f16bf24dd64
VEHICLE_CATALOG_SYNC_ENABLED=true
# URL API CKAN package_show (défaut = open.canada.ca + dataset id ci-dessous)
VEHICLE_CATALOG_SOURCE_DATASET_URL=
VEHICLE_CATALOG_SOURCE_DATASET_ID=98f1a129-f628-4ce4-b24d-6f16bf24dd64
VEHICLE_CATALOG_SYNC_CRON="30 3 * * 0"
VEHICLE_CATALOG_HTTP_TIMEOUT_MS=60000
VEHICLE_CATALOG_MAX_FILE_SIZE_MB=50
VEHICLE_CATALOG_PREFER_LANGUAGE=en
VEHICLE_CATALOG_BATCH_SIZE=200

# --- FDE — Fuel Data Engine (prix carburant, backend only) ---
# Domaine attendu production : https://fde.monteregia.com
# Ne jamais préfixer FDE_API_KEY avec NEXT_PUBLIC_ / PUBLIC_ / VITE_
FDE_ENABLED=false
FDE_BASE_URL=https://fde.monteregia.com
FDE_API_KEY=
FDE_TIMEOUT_MS=5000
FDE_NEARBY_DEFAULT_RADIUS_KM=10
FDE_NEARBY_MAX_RADIUS_KM=50
FDE_NEARBY_DEFAULT_LIMIT=20
FDE_NEARBY_MAX_LIMIT=50
FDE_CACHE_TTL_SECONDS=300
FDE_STALE_PRICE_MAX_HOURS=24
# Horizon découverte stations (identité) — indépendant de la fraîcheur « exacte »
FDE_DISCOVERY_MAX_AGE_HOURS=168
FDE_ALLOW_STALE_CACHE_HOURS=6

# --- Simulation carburant / plan de ravitaillement (optionnel) ---
# FUEL_SEARCH_THRESHOLD_FRACTION=0.25
# FUEL_RESERVE_FRACTION=0.15
# FUEL_RESERVE_MIN_KM=75
# FUEL_MAX_DETOUR_KM=15
# FUEL_LOOKAHEAD_KM=250
# FUEL_MIN_PRICE_ADVANTAGE=0.03
# FUEL_MIN_TANK_CAPACITY_L=10
# FUEL_MAX_TANK_CAPACITY_L=500
# FUEL_INITIAL_TANK_STRATEGY=full_unbilled
# FUEL_STATION_SAMPLE_INTERVAL_KM=40
# FUEL_MAX_STATION_SAMPLES=30
# FUEL_CORRIDOR_RADIUS_KM=5
# FUEL_CORRIDOR_RADIUS_SPARSE_KM=10
# Logs diagnostics serveur uniquement (jamais exposés à l'UI). Valeur: 1 pour activer.
# FUEL_DEBUG=1

# --- Entretien véhicule (calendriers fournisseurs + VIN + rappels) ---
# mock | commercial | manual (ou nom fournisseur: motor, dataone, …)
# mock INTERDIT en production sauf MAINTENANCE_ALLOW_MOCK=true (dev Contabo uniquement).
MAINTENANCE_PROVIDER=mock
MAINTENANCE_ALLOW_MOCK=false
MAINTENANCE_PROVIDER_BASE_URL=
MAINTENANCE_PROVIDER_API_KEY=
MAINTENANCE_PROVIDER_TIMEOUT_MS=10000
MAINTENANCE_PROVIDER_CACHE_HOURS=168
MAINTENANCE_PROVIDER_MAX_RETRIES=2

# NHTSA vPIC — décodage VIN (serveur uniquement, gratuit)
NHTSA_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_VPIC_TIMEOUT_MS=10000

# Rappels de sécurité Transport Canada (URL open data / API licenciée)
TRANSPORT_CANADA_RECALLS_BASE_URL=
TRANSPORT_CANADA_RECALLS_TIMEOUT_MS=15000
TRANSPORT_CANADA_RECALLS_CACHE_HOURS=168

# --- Administration (Phase 1+) ---
# Environnement affiché dans le bandeau admin : development | staging | production
SEBAVIO_ENV=development
# MFA obligatoire pour les comptes staff (Phase 7 — préparer, ne pas activer trop tôt)
ADMIN_MFA_REQUIRED=false
# Coffre de secrets IA (Phase 5) — clé maître ≥ 32 octets, jamais en base
SEBAVIO_SECRETS_MASTER_KEY=
# Fournisseurs IA (serveur uniquement, jamais NEXT_PUBLIC_*)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
